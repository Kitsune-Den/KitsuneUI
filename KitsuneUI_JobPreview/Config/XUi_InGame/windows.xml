<configs>

	<!-- ================================================================ -->
	<!-- Trader / NPC dialog: a strip of tiles under the speaker, above   -->
	<!-- the toolbelt and the subtitle line. Up to 10 options (the game's -->
	<!-- maximum) in one row; the speaker's name sits above the strip.    -->
	<!-- KitsuneUI's glass panel for the list is hidden in this layout.   -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowResponses']/@anchor">Bottom</set>
	<set xpath="/windows/window[@name='windowResponses']/@pos">-760,440</set>
	<set xpath="/windows/window[@name='windowResponses']/@width">1520</set>
	<set xpath="/windows/window[@name='windowResponses']/@height">200</set>
	<setattribute xpath="/windows/window[@name='windowResponses']/sprite[@name='background' or @name='kuHeader']" name="color">[transparent]</setattribute>
	<set xpath="/windows/window[@name='windowResponses']/sprite[@name='kuIcon']/@pos">2,-4</set>
	<set xpath="/windows/window[@name='windowResponses']/label[@name='lblName']/@pos">40,-4</set>
	<setattribute xpath="/windows/window[@name='windowResponses']/label[@name='lblName']" name="effect">outline</setattribute>
	<setattribute xpath="/windows/window[@name='windowResponses']/label[@name='lblName']" name="effect_color">0,0,0,200</setattribute>

	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@pos">0,-40</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@rows">1</set>
	<setattribute xpath="/windows/window[@name='windowResponses']/grid[@name='items']" name="cols">10</setattribute>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@width">1520</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@height">158</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@cell_width">152</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@cell_height">158</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@arrangement">horizontal</set>
	<!-- Keeps the strip centred under the speaker: with fewer than 10 options the window
	     shifts right by half the unused width (XUiC_KitsuneDialogStrip). -->
	<setattribute xpath="/windows/window[@name='windowResponses']/grid[@name='items']" name="controller">KitsuneDialogStrip, KitsuneUI_JobPreview</setattribute>

	<!-- ================================================================ -->
	<!-- Job offer, layout A: the location picture on the left (name over -->
	<!-- it, tier / distance / biome under it), description and the       -->
	<!-- objectives on the right, Accept and Decline below.               -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowQuestOffer']/@width">740</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/@height">430</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/@pos">-370, 170</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='header']/label[@text='{tieradd}']/@pos">532,-10</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='header']/sprite[@sprite='ui_game_symbol_quest_limited']/@pos">702,-5</set>

	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/label[@name='descriptionText']/@pos">366,-12</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/label[@name='descriptionText']/@width">360</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/label[@name='descriptionText']/@height">170</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/label[@name='descriptionText']/@font_size">24</set>
	<setattribute xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/label[@name='descriptionText']" name="overflow">shrinkcontent</setattribute>

	<append xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']">
		<rect name="kuJobPreview" controller="KitsuneJobOffer, KitsuneUI_JobPreview" pos="0,0" depth="2">
			<!-- picture -->
			<rect pos="14,-12" width="336" height="252">
				<sprite depth="1" name="kuGlow" sprite="ku_glow" type="sliced" pos="-12,12" width="360" height="276" color="[kuAccentSoft]" />
				<sprite depth="2" name="kuImageWell" sprite="ku_round_md" type="sliced" width="336" height="252" color="[kuSlotWell]" />
				<texture depth="3" name="kuImage" pos="1,-1" width="334" height="250" texture="{kj_image}" material="Materials/Transparent Colored" visible="{kj_hasimage}" />
				<sprite depth="4" name="kuShade" sprite="ku_fade_up" pos="1,-170" width="334" height="81" color="8,10,22,235" />
				<label depth="5" name="kuName" pos="12,-242" width="312" height="40" pivot="bottomleft" justify="left" font_size="26" max_line_count="1" overflow="shrinkcontent" text="{kj_name}" color="[kuTextBright]" effect="outline" effect_color="0,0,0,200" />
				<sprite depth="6" name="kuRing" sprite="ku_round_md_ring" type="sliced" width="336" height="252" color="[kuAccent]" />
			</rect>

			<!-- chips: tier, distance + direction, biome -->
			<sprite depth="2" pos="14,-272" width="18" height="18" sprite="ui_game_symbol_skull" color="[kuDanger]" />
			<label depth="2" pos="36,-270" width="80" height="24" font_size="20" text="{kj_tier}" color="[kuTextMid]" />
			<sprite depth="2" pos="122,-272" width="18" height="18" sprite="ui_game_symbol_compass" color="[kuAccent]" />
			<label depth="2" pos="144,-270" width="96" height="24" font_size="20" text="{kj_distance}" color="[kuTextMid]" overflow="shrinkcontent" />
			<sprite depth="2" pos="244,-272" width="18" height="18" sprite="ui_game_symbol_foliage" color="[kuFood]" />
			<label depth="2" pos="266,-270" width="90" height="24" font_size="20" text="{kj_biome}" color="[kuTextMid]" overflow="shrinkcontent" />

			<!-- objectives -->
			<rect pos="366,-190" visible="{kj_hasobjectives}">
				<sprite depth="2" pos="0,0" width="360" height="2" sprite="ku_rule" color="[kuGoldSoft]" />
				<label depth="2" pos="0,-8" width="360" height="22" font_size="16" upper_case="true" text_key="xuiObjectives" color="[kuGold]" />
				<label depth="2" pos="0,-34" width="360" height="90" font_size="19" spacing_y="4" text="{kj_objectives}" color="[kuTextMid]" overflow="shrinkcontent" />
			</rect>
		</rect>
	</append>

	<!-- Accept / Decline: two wide, spaced buttons under the content. -->
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept']/@pos">14, -384</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnDecline']/@pos">376, -384</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept' or @name='btnDecline']/@height">44</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept' or @name='btnDecline']/*[@width='303']/@width">350</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept' or @name='btnDecline']/rect/@height">40</set>

</configs>
