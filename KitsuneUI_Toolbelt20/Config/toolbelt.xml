<configs>

	<!-- In-game toolbelt size. Vanilla only ever reads <editorconfig>; the DLL makes it read -->
	<!-- this too. Pick one:                                                                    -->
	<!--   Two bars of 10 (the default): slot_per_bar="10" bar_per_page="2"                     -->
	<!--     Bar 2 is shift + 1..0. KitsuneUI Settings can stack them or put them in one row.   -->
	<!--   One bar of 11 to 20: slot_per_bar="15" bar_per_page="1" (any number from 11 to 20)  -->
	<!--     1..0 pick slots 1-10, shift + 1, 2, ... pick slot 11, 12, ...                     -->
	<!-- Two bars of 10 and one bar of 20 keep every item in the same place, so you can switch -->
	<!-- between them. Going smaller moves the extra items into the backpack.                   -->
	<!-- shift_keys enabled="false" turns shift + number off (for sprinting on shift): 1..0    -->
	<!-- always pick slots 1-10 and the rest are reached with the mouse wheel.                  -->
	<!-- The game clamps 10 or fewer slots to 1-10 per bar, 1-2 bars and 1-10 pages; more than -->
	<!-- one page shows the vanilla page arrows.                                                -->
	<append xpath="/toolbelt">
		<gameconfig>
			<slots slot_per_bar="10" bar_per_page="2" page_count="1" />
			<shift_keys enabled="true" />
		</gameconfig>
	</append>

</configs>
