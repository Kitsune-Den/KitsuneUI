<configs>

	<!-- One bar of more than 10 (toolbelt.xml): the window is laid out for 10 slots, so the -->
	<!-- DLL moves the belt left by half the extra width and stretches its frame and XP strip. -->
	<append xpath="/windows/window[@name='windowToolbelt']/rect/rect[@controller='Toolbelt']">
		<rect name="kuBeltWiden" width="1" height="1" controller="KitsuneBeltWiden, KitsuneUI_Toolbelt20" />
	</append>

	<!-- A dropped death bag opens in the bag window (windowBagStorage, the one vehicles use), -->
	<!-- not the loot window. It builds one pool of item-stack controllers from its grid's     -->
	<!-- rows x cols and never shows slots past it, however big the bag is. Vanilla has 150    -->
	<!-- (10x15), enough for its own 8x15 death bag and for 8x17 with 20 belt slots, but not   -->
	<!-- for a bag mod's: KitsuneBackpack200 comes to 8x30 = 240. So the pool goes up to 320,  -->
	<!-- unless another mod already made it that big. Only the spare slots change; the window  -->
	<!-- still takes its columns and rows from the bag it shows.                                -->
	<set xpath="/windows/window[@name='windowBagStorage']//grid[@name='queue'][@rows * @cols &lt; 320]/@rows">32</set>

</configs>
