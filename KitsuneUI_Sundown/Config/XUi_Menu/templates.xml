<configs>

	<!-- ================================================================ -->
	<!-- Main menu buttons: capitals centred in the column, no pill.      -->
	<!-- White when hovered, faded white otherwise.                       -->
	<!-- ================================================================ -->
	<set xpath="/templates/mainmenubutton/@color_hovered">0,0,0,0</set>
	<set xpath="/templates/mainmenubutton/@text_color_default">255,255,255,120</set>
	<set xpath="/templates/mainmenubutton/@text_color_hovered">255,255,255,255</set>
	<set xpath="/templates/mainmenubutton/label/@pivot">center</set>
	<setattribute xpath="/templates/mainmenubutton/label" name="justify">center</setattribute>
	<set xpath="/templates/mainmenubutton/label/sprite[@name='bgRight']/@color">0,0,0,0</set>

	<!-- ================================================================ -->
	<!-- Paging tabs (Play Game, Options, Editing Tools, the settings row -->
	<!-- under them and the server filters): plain capitals, faded idle,  -->
	<!-- white on hover, and a hot pink bar under the open one instead of -->
	<!-- the bracket boxes. The tall band under the open tab becomes a    -->
	<!-- faint lavender hairline the bar sits on.                         -->
	<!-- ================================================================ -->
	<set xpath="/templates/pagingheader_button/label/@color">{% !btn_enabled ? color(255,255,255,50) : ((defined('btn_selected') and btn_selected) or btn_hovered ? color(255,255,255,255) : color(255,255,255,140) ) }</set>
	<set xpath="/templates/sandbox_tabbutton/rect/label/@color">{% !btn_enabled ? color(255,255,255,50) : (tab_highlight ? color(170,150,235,255) : ((defined('btn_selected') and btn_selected) or btn_hovered ? color(255,255,255,255) : color(255,255,255,140) ) ) }</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@sprite | /templates/sandbox_tabbutton/rect/label/sprite/@sprite">sd_line</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@fillcenter | /templates/sandbox_tabbutton/rect/label/sprite/@fillcenter">true</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@color | /templates/sandbox_tabbutton/rect/label/sprite/@color">{% !btn_enabled ? color(0,0,0,0) : (defined('btn_selected') and btn_selected ? color(255,105,170,255) : (btn_hovered ? color(255,255,255,70) : color(0,0,0,0) ) ) }</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@anchor_left | /templates/sandbox_tabbutton/rect/label/sprite/@anchor_left">#parent,0,-4</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@anchor_right | /templates/sandbox_tabbutton/rect/label/sprite/@anchor_right">#parent,1,4</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@anchor_bottom | /templates/sandbox_tabbutton/rect/label/sprite/@anchor_bottom">#parent,0.5,-27</set>
	<set xpath="/templates/pagingheader_button/label/sprite/@anchor_top | /templates/sandbox_tabbutton/rect/label/sprite/@anchor_top">#parent,0.5,-23</set>

	<set xpath="/templates/pagingheader_subheaderline/sprite[@name='subheader_line']/@sprite">sd_line</set>
	<set xpath="/templates/pagingheader_subheaderline/sprite[@name='subheader_line']/@type">sliced</set>
	<set xpath="/templates/pagingheader_subheaderline/sprite[@name='subheader_line']/@color">170,150,235,70</set>
	<set xpath="/templates/pagingheader_subheaderline/sprite[@name='subheader_line']/@anchor_bottom">{open_window_key}Border,0,0</set>
	<set xpath="/templates/pagingheader_subheaderline/sprite[@name='subheader_line']/@anchor_top">{open_window_key}Border,0,1</set>

	<!-- ================================================================ -->
	<!-- Save cards and server rows sit on a dark glass card, so they     -->
	<!-- read over the menu video; selection and hover glass go on top.   -->
	<!-- ================================================================ -->
	<!-- Save cards sit on Continue Game's glass panel, so theirs is a faint -->
	<!-- lavender; the selected one gets a hot pink bar down its left edge.  -->
	<set xpath="/templates/savegames_list_entry/rect/sprite[@name='kuCard']/@color">170,150,235,16</set>
	<insertAfter xpath="/templates/savegames_list_entry/rect/sprite[@name='background']">
		<sprite depth="4" name="sdSelBar" sprite="sd_line" type="sliced" ignoreparentpadding="true" pos="0,0" width="4" height="${height}" pivot="topleft" color="{% isselected ? color(255,105,170,255) : color(0,0,0,0) }" />
	</insertAfter>
	<set xpath="/templates/savegames_list_entry/@matching_version_color">80,230,200,255</set>
	<set xpath="/templates/savegames_list_entry/@compatible_version_color">255,196,96,255</set>

	<!-- Page titles (Play Game, Options, Editing Tools): big white capitals -->
	<!-- led by a pink tick, kept above the hairline under the tabs.          -->
	<setattribute xpath="/templates/menu_paging_header/rect/label[@name='menuName']" name="color">[kuTextBright]</setattribute>
	<set xpath="/templates/menu_paging_header/rect/label[@name='menuName']/@font_size">46</set>
	<set xpath="/templates/menu_paging_header/rect/label[@name='menuName']/@pos">76,-6</set>
	<set xpath="/templates/menu_paging_header/rect/label[@name='menuName']/@overflow_height">80</set>
	<insertBefore xpath="/templates/menu_paging_header/rect/label[@name='menuName']">
		<sprite name="sdTitleTick" depth="2" sprite="sd_line" type="sliced" pos="58,-6" width="6" height="34" pivot="left" color="255,105,170,255" />
	</insertBefore>
	<insertBefore xpath="/templates/servers_list_entry/rect/sprite[@name='background']">
		<sprite depth="1" name="sdCard" sprite="ku_round_sm" type="sliced" color="24,22,36,205" ignoreparentpadding="true" visible="{hasentry}" />
	</insertBefore>

	<!-- ===== GENERATED by tools/gen_sundown.py: Kitsunebi's literal colours -> Sundown. Do not edit by hand. ===== -->
	<set xpath="//*[@color='111,227,255,170']/@color">255,105,170,170</set>
	<set xpath="//*[@color='111,227,255,255']/@color">255,105,170,255</set>
	<set xpath="//*[@color='30,84,118,255']/@color">120,44,104,255</set>
	<set xpath="//*[@color='{% !hasentry ? color(0,0,0,0) : (isselected ? color(30,84,118,255) : (hovered ? color(255,255,255,255) : color(0,0,0,0) ) ) }']/@color">{% !hasentry ? color(0,0,0,0) : (isselected ? color(120,44,104,255) : (hovered ? color(255,255,255,255) : color(0,0,0,0) ) ) }</set>
	<set xpath="//*[@color=&quot;{% defined('option_hovered') and option_hovered ? '111,227,255,255' : '150,175,255,28' }&quot;]/@color">{% defined('option_hovered') and option_hovered ? '255,105,170,255' : '170,150,235,28' }</set>
	<set xpath="//*[@color=&quot;{% option_hovered ? '111,227,255,255' : '150,175,255,28' }&quot;]/@color">{% option_hovered ? '255,105,170,255' : '170,150,235,28' }</set>
	<set xpath="//*[@color=&quot;{% option_hovered ? '30,84,118,200' : '255,255,255,8' }&quot;]/@color">{% option_hovered ? '120,44,104,200' : '255,255,255,8' }</set>
	<set xpath="//*[@color_changed='111,227,255,255']/@color_changed">255,105,170,255</set>
	<set xpath="//*[@color_fav_selected='111,227,255,255']/@color_fav_selected">255,105,170,255</set>
	<set xpath="//*[@color_selected='111,227,255,255']/@color_selected">255,105,170,255</set>
	<set xpath="//*[@enabled_color='{% option_default ? color(255,255,255,255) : color(111,227,255,255) }']/@enabled_color">{% option_default ? color(255,255,255,255) : color(255,105,170,255) }</set>
	<set xpath="//*[@thumb_color_active='111,227,255,255']/@thumb_color_active">255,105,170,255</set>
	<set xpath="//*[@thumb_color_hover='111,227,255,255']/@thumb_color_hover">255,105,170,255</set>
	<set xpath="//*[@thumb_color_inactive='111,227,255,255']/@thumb_color_inactive">255,105,170,255</set>
	<!-- ===== END GENERATED ===== -->

</configs>
