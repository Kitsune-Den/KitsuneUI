<configs>

	<!-- ================================================================ -->
	<!-- Recipe rows: name left-aligned beside the icon, the icon in a    -->
	<!-- faint lavender well with a ring (a dark well didn't show on the -->
	<!-- dark rows), kept out of the game's Background opacity. A 3px    -->
	<!-- gap between wells. Row colours: the KitsuneRows atlas.          -->
	<!-- ================================================================ -->
	<set xpath="/templates/recipe_entry/rect/label[@name='Name']/@pos">64,-22</set>
	<set xpath="/templates/recipe_entry/rect/label[@name='Name']/@pivot">left</set>
	<set xpath="/templates/recipe_entry/rect/label[@name='Name']/@justify">left</set>
	<set xpath="/templates/recipe_entry/rect/label[@name='Name']/@width">280</set>
	<insertBefore xpath="/templates/recipe_entry/rect/sprite[@name='Icon']">
		<sprite depth="4" name="sdIconWell" sprite="ku_slot_fill" type="sliced" color="170,150,235,40" globalopacitymod="0" pos="13,-2" width="42" height="40" />
		<sprite depth="4" name="sdIconRing" sprite="ku_slot_ring" type="sliced" color="170,150,235,110" globalopacitymod="0" pos="13,-2" width="42" height="40" />
	</insertBefore>

	<!-- ================================================================ -->
	<!-- Slots: flat dark wells, no glow. Empty slots past carry capacity -->
	<!-- get pink stripes (the game only says so through the pack mule    -->
	<!-- lock icon, so that is what the stripes test for).                -->
	<!-- ================================================================ -->
	<setattribute xpath="/templates/item_stack/rect/sprite[@name='kuGlow']" name="visible">false</setattribute>
	<insertAfter xpath="/templates/item_stack/rect/sprite[@name='highlightOverlay']">
		<sprite depth="3" name="sdLockHatch" sprite="sd_slot_hatch" color="255,105,170,55" pos="1,-1" width="${-2+cell_size}" height="${-2+cell_size}"
			visible="{# isassemblelocked and stacklockicon == 'ui_game_symbol_pack_mule' }" />
	</insertAfter>

	<!-- ===== GENERATED by tools/gen_sundown.py: Kitsunebi's literal colours -> Sundown. Do not edit by hand. ===== -->
	<set xpath="//*[@color='6,8,20,128']/@color">16,14,26,128</set>
	<set xpath="//*[@color=&quot;{% rowstatecolor = '217,184,115,255' or rowstatecolor = '255,255,255,255' ? color(30,84,118,235) : color(0,0,0,0) }&quot;]/@color">{% rowstatecolor = '170,150,235,255' or rowstatecolor = '255,255,255,255' ? color(120,44,104,235) : color(0,0,0,0) }</set>
	<set xpath="//*[@color_bg_available='40,60,96,225']/@color_bg_available">66,58,92,225</set>
	<set xpath="//*[@row_color='150,175,255,40']/@row_color">170,150,235,40</set>
	<conditional>
		<if cond="(mod_loaded('KitsuneUI_JobPreview') || mod_loaded('KitsuneUI_Settings'))">
			<set xpath="//*[@color='12,14,30,225']/@color">28,26,42,225</set>
		</if>
	</conditional>
	<conditional>
		<if cond="mod_loaded('KitsuneUI_JobPreview')">
			<set xpath="//*[@color='30,84,118,245']/@color">120,44,104,245</set>
		</if>
	</conditional>
	<conditional>
		<if cond="mod_loaded('KitsuneUI_Settings')">
			<set xpath="//*[@color='12,14,30,210']/@color">28,26,42,210</set>
			<set xpath="//*[@color='30,84,118,120']/@color">120,44,104,120</set>
			<set xpath="//*[@color='6,8,20,190']/@color">16,14,26,190</set>
		</if>
	</conditional>
	<!-- ===== END GENERATED ===== -->

</configs>
