<configs>

	<!-- Item slots, added to the shared template (bag, toolbelt, loot, workstations) and -->
	<!-- hidden until KitsuneUI_Settings shows them:                                       -->
	<!--   kuWearRing:  toolbelt items under 20% durability (amber) or 5% (red)            -->
	<!--   kuSearchDim: dims backpack slots that don't match the search box                -->
	<!--   kuQualityRing: a thin ring in the item's quality colour, set in from the edge   -->
	<append xpath="/templates/item_stack/rect">
		<sprite depth="9" name="kuQualityRing" sprite="ku_slot_ring" type="sliced" color="{durabilitycolor}" visible="{kuqualityring}" globalopacitymod="0"
			pos="4,-4" width="${-8+cell_size}" height="${-8+cell_size}" />
		<sprite depth="10" name="kuWearRing" sprite="ku_slot_ring2" type="sliced" color="255,178,74,255" visible="false" globalopacitymod="0"
			pos="1,-1" width="${-2+cell_size}" height="${-2+cell_size}" />
		<sprite depth="12" name="kuSearchDim" sprite="ku_slot_fill" type="sliced" color="6,8,20,190" visible="false" globalopacitymod="0"
			pos="1,-1" width="${-2+cell_size}" height="${-2+cell_size}" />
	</append>

	<!-- Quest tracker objective lines (Settings > Windows): a thin progress bar under   -->
	<!-- objectives that count ("3/10"), and an arrow beside "go to" objectives pointing -->
	<!-- the way. XUiC_KitsuneQuestObjective reads the line's objective.                 -->
	<append xpath="/templates/quest_objective_tracker_entry/rect">
		<rect name="kuObjExtras" width="300" height="26" controller="KitsuneQuestObjective, KitsuneUI_Settings">
			<sprite depth="2" name="kuObjTrack" pos="130,-20" width="146" height="6" sprite="ku_bar" type="sliced" color="12,14,30,210" visible="{kuobjbar}" />
			<sprite depth="3" name="kuObjFill" pos="130,-20" width="146" height="6" sprite="ku_bar" type="filled" fill="{kuobjfill}" fillinvert="false" color="[kuAccent]" visible="{kuobjbar}" />
			<sprite depth="3" name="kuObjArrow" pos="291,-13" width="20" height="20" pivot="center" sprite="ui_game_symbol_map_player_arrow" color="[kuGold]" visible="{kuobjarrow}" />
		</rect>
	</append>

</configs>
