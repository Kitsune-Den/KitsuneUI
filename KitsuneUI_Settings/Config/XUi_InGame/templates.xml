<configs>

	<!-- Item slots, added to the shared template (bag, toolbelt, loot, workstations) and -->
	<!-- hidden until KitsuneUI_Settings shows them:                                       -->
	<!--   kuWearRing:  toolbelt items under 20% durability (amber) or 5% (red)            -->
	<!--   kuSearchDim: dims backpack slots that don't match the search box                -->
	<!--   kuQualityRing: a thin ring in the item's quality colour, set in from the edge   -->
	<append xpath="/templates/item_stack/rect">
		<sprite depth="9" name="kuQualityRing" sprite="ku_slot_ring" type="sliced" color="{durabilitycolor}" visible="{kuqualityring}" globalopacitymod="0"
			pos="4,-4" width="${-8+cell_size}" height="${-8+cell_size}" />
		<sprite depth="10" name="kuWearRing" sprite="ku_slot_ring2" type="sliced" color="255,178,74,255" visible="false" globalopacitymod="0"
			pos="1,-1" width="${-2+cell_size}" height="${-2+cell_size}" />
		<sprite depth="12" name="kuSearchDim" sprite="ku_slot_fill" type="sliced" color="6,8,20,190" visible="false" globalopacitymod="0"
			pos="1,-1" width="${-2+cell_size}" height="${-2+cell_size}" />
	</append>

	<!-- Quest tracker objective lines (Settings > Windows): a thin progress bar under   -->
	<!-- objectives that count ("3/10"), and an arrow beside "go to" objectives pointing -->
	<!-- the way. XUiC_KitsuneQuestObjective reads the line's objective.                 -->
	<append xpath="/templates/quest_objective_tracker_entry/rect">
		<rect name="kuObjExtras" width="300" height="26" controller="KitsuneQuestObjective, KitsuneUI_Settings">
			<sprite depth="2" name="kuObjTrack" pos="130,-20" width="146" height="6" sprite="ku_bar" type="sliced" color="12,14,30,210" visible="{kuobjbar}" />
			<sprite depth="3" name="kuObjFill" pos="130,-20" width="146" height="6" sprite="ku_bar" type="filled" fill="{kuobjfill}" fillinvert="false" color="[kuAccent]" visible="{kuobjbar}" />
			<sprite depth="3" name="kuObjArrow" pos="291,-13" width="20" height="20" pivot="center" sprite="ui_game_symbol_map_player_arrow" color="[kuGold]" visible="{kuobjarrow}" />
		</rect>
	</append>

	<!-- ================================================================ -->
	<!-- Framework: ku_move_handle (public, see docs/framework.md). Put it -->
	<!-- in any HUD window, inside mod_loaded('KitsuneUI_Settings'), and   -->
	<!-- the window joins Move HUD: drag, size, hide, snap, profiles,      -->
	<!-- saved as move.<window name>. pos / width / height outline the     -->
	<!-- piece; label_key names it on the outline's strip. group is        -->
	<!-- optional (several handles, one piece). open_for_moving="true"    -->
	<!-- opens a window that only shows now and then while Move HUD is on. -->
	<!-- ================================================================ -->
	<append xpath="/templates">
		<ku_move_handle pos="0,0" width="300" height="60" label_key="" label="" group="" open_for_moving="false">
			<rect name="kuMoveHandle" depth="50" pos="${pos}" width="${width}" height="${height}" on_drag="true" group="${group}" open_for_moving="${open_for_moving}"
				controller="KitsuneMoveHandle, KitsuneUI_Settings">
				<!-- the strip's controls; XUiC_KitsuneMoveHandle lays them out above (or below) the outline -->
				<label depth="53" name="kuMoveScale" pos="0,0" width="64" height="24" pivot="right" justify="right" font_size="18" color="[kuGold]" effect="outline" effect_color="0,0,0,220" text="100%" />
				<sprite depth="54" name="kuChipSmaller" pos="0,0" sprite="ku_round_sm" type="sliced" width="30" height="30" color="12,14,30,225" />
				<button depth="55" name="kuBtnSmaller" pos="0,0" sprite="ui_game_symbol_subtract" width="22" height="22" pivot="center" defaultcolor="[kuTextBright]" hovercolor="[kuAccent]" style="press, hover" sound="[paging_click]" />
				<sprite depth="54" name="kuChipBigger" pos="0,0" sprite="ku_round_sm" type="sliced" width="30" height="30" color="12,14,30,225" />
				<button depth="55" name="kuBtnBigger" pos="0,0" sprite="ui_game_symbol_add" width="22" height="22" pivot="center" defaultcolor="[kuTextBright]" hovercolor="[kuAccent]" style="press, hover" sound="[paging_click]" />
				<sprite depth="54" name="kuChipHide" pos="0,0" sprite="ku_round_sm" type="sliced" width="30" height="30" color="12,14,30,225" />
				<button depth="55" name="kuBtnHide" pos="0,0" sprite="ku_icon_eye" width="22" height="22" pivot="center" defaultcolor="[kuTextBright]" hovercolor="[kuAccent]" style="press, hover" sound="[paging_click]" />
				<sprite depth="50" name="kuMoveFill" sprite="ku_round_md" type="sliced" color="30,84,118,120" />
				<sprite depth="51" name="kuMoveRing" sprite="ku_round_md_ring" type="sliced" color="[kuAccent]" />
				<label depth="52" name="kuMoveName" pos="12,-19" width="${width - 168}" height="30" pivot="left" justify="left" font_size="22" overflow="shrinkcontent" color="[kuTextBright]" effect="outline" effect_color="0,0,0,220" text="${label}" text_key="${label_key}" />
			</rect>
		</ku_move_handle>
	</append>

</configs>
