<configs>

	<!-- The KitsuneUI settings window, opened from the Esc menu's KitsuneUI button. -->
	<append xpath="/xui">
		<window_group name="kuSettings">
			<window name="kuSettingsWindow" />
		</window_group>
		<!-- HUD move mode: the bar at the top with Reset and Done (Settings > Move HUD). -->
		<window_group name="kuMove">
			<window name="kuMoveBar" />
		</window_group>
	</append>

</configs>
