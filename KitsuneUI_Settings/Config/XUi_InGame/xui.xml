<configs>

	<!-- The KitsuneUI settings window, opened from the Esc menu's KitsuneUI button. -->
	<append xpath="/xui">
		<window_group name="kuSettings">
			<window name="kuSettingsWindow" />
		</window_group>
		<!-- Profiles: named layouts, export / import (Settings > Profiles). -->
		<window_group name="kuProfiles">
			<window name="kuProfilesWindow" />
		</window_group>
		<!-- HUD move mode: the bar at the top with Reset and Done (Settings > Move HUD). -->
		<window_group name="kuMove">
			<window name="kuMoveGrid" />
			<window name="kuMoveBar" />
		</window_group>
	</append>

	<!-- The minimap rides in the toolbelt group, so it is up whenever the HUD is. -->
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="kuMinimap" />
		<window name="kuCraftingHud" />
		<window name="kuPlayerFrame" />
		<window name="kuTargetFrame" />
	</append>

</configs>
