<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KitsuneUI_JobPreview</AssemblyName>
    <RootNamespace>KitsuneUI.JobPreview</RootNamespace>
    <Optimize>true</Optimize>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameBinaries>$(MSBuildProjectDirectory)\..\..\7dtd-binaries</GameBinaries>
    <ModFolder>$(MSBuildProjectDirectory)\..\..\KitsuneUI_JobPreview</ModFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameBinaries)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(GameBinaries)\LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameBinaries)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameBinaries)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The settings file format is shared with KitsuneUI_Settings, which writes it. -->
  <ItemGroup>
    <Compile Include="..\Shared\KitsuneSettingsFile.cs" Link="KitsuneSettingsFile.cs" />
  </ItemGroup>

  <Target Name="CopyToModFolder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)" />
  </Target>
</Project>
