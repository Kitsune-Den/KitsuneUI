<configs>

	<!-- Everything here is for Kitsune Shugyō's practice meters. Without it, the game's -->
	<!-- windows are left exactly as they are and there is no Practice tab.             -->
	<conditional>
		<if cond="mod_loaded('KitsuneShugyo')">

			<!-- ================================================================ -->
			<!-- The Practice tab in the top tab bar, after Players. The bar      -->
			<!-- grows 50 to the right for it (the title stays centred on the     -->
			<!-- screen) and Creative, shown only in creative mode, moves one     -->
			<!-- place along. The tab opens the kuPractice window group by name.  -->
			<!-- ================================================================ -->
			<setattribute xpath="/windows/window[@name='windowPagingHeader']" name="width">650</setattribute>
			<setattribute xpath="/windows/window[@name='windowPagingHeader']/sprite[@style='paging.window.background.border']" name="width">650</setattribute>
			<setattribute xpath="/windows/window[@name='windowPagingHeader']/sprite[@style='paging.window.background']" name="width">644</setattribute>
			<insertAfter xpath="/windows/window[@name='windowPagingHeader']/iconbutton[@name='Players']">
				<iconbutton pos="576,-21" depth="3" selectable="true" collider_scale="1.5" name="kuPractice" sprite="ku_icon_flame" tooltip_key="xuikuPractice" snap="false" gamepad_selectable="false" />
			</insertAfter>
			<set xpath="/windows/window[@name='windowPagingHeader']/iconbutton[@name='Creative']/@pos">626,-21</set>
			<set xpath="/windows/window[@name='windowPagingHeader']/gamepad_icon[@name='RB_Icon']/@pos">658,-20</set>

			<!-- ================================================================ -->
			<!-- The Practice window: the five attributes, then the 24 crafting   -->
			<!-- skills in two columns. Each row: level or rank, a bar towards    -->
			<!-- the next one, and a Tired tag on a tired attribute.              -->
			<!-- ================================================================ -->
			<append xpath="/windows">
				<window name="kuPracticeWindow" width="1000" height="770" panel="Center" controller="KitsunePracticeWindow, KitsuneUI_Practice" cursor_area="true">
					<ku_window_body />
					<rect name="header" height="43" depth="1">
						<headerbg />
						<sprite pos="4,-5" depth="2" name="windowIcon" style="icon32px" sprite="ku_icon_flame" color="[kuAccent]" />
						<label style="header.name" text_key="xuikuPractice" color="[kuGold]" />
						<label pos="985,-11" depth="2" width="600" height="24" font_size="20" justify="right" pivot="topright" max_line_count="1" overflow="shrinkcontent" color="[kuTextMuted]" text_key="kuPracticeSubtitle" />
					</rect>

					<rect name="content" pos="0,-52" depth="1">
						<ku_section pos="16,0" width="968" text_key="kuPracticeAttributes" />
						<grid name="kuPracticeAttributes" pos="16,-40" rows="5" cols="1" cell_width="968" cell_height="42" repeat_content="true" arrangement="vertical">
							<ku_practice_row kind="attribute" width="968" height="42" font_size="26" icon_size="28"
								name_w="250" level_x="300" level_w="150" bar_x="470" bar_w="320" pct_x="796" pct_w="60" tired_x="868" />
						</grid>

						<ku_section pos="16,-262" width="968" text_key="kuPracticeCrafting" />
						<grid name="kuPracticeCrafting" pos="16,-302" rows="12" cols="2" cell_width="488" cell_height="34" repeat_content="true" arrangement="vertical">
							<ku_practice_row kind="crafting" width="480" height="34" font_size="22" icon_size="22"
								name_w="170" level_x="214" level_w="76" bar_x="300" bar_w="120" pct_x="424" pct_w="52" />
						</grid>
					</rect>
				</window>
			</append>

			<!-- The attribute window's "Buy" column header says "Practice" instead. -->
			<setattribute xpath="/windows/window[@name='windowSkillAttributeInfo']//rect[@name='tableHeader']/rect/label[@text_key='xuiSkillBuy']" name="text">{kp_buyheader}</setattribute>
			<removeattribute xpath="/windows/window[@name='windowSkillAttributeInfo']//rect[@name='tableHeader']/rect/label[@text_key='xuiSkillBuy']/@text_key" />
			<setattribute xpath="/windows/window[@name='windowSkillAttributeInfo']//rect[@name='tableHeader']/rect/label[@text='{kp_buyheader}']" name="overflow">shrinkcontent</setattribute>

		</if>
	</conditional>

</configs>
