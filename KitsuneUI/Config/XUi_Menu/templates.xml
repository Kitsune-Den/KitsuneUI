<configs>

	<!-- ===== GENERATED by tools/gen_menu_recolor.py: vanilla red -> Kitsunebi. Do not edit by hand. ===== -->
	<set xpath='//boxshadow_new[@color="228,18,21,170"]/@color'>111,227,255,170</set>
	<set xpath='//combobox[@enabled_color="{% option_default ? color(255,255,255,255) : color(228,18,21,255) }"]/@enabled_color'>{% option_default ? color(255,255,255,255) : color(111,227,255,255) }</set>
	<set xpath='//combobox[@enabled_fill_color="[red]"]/@enabled_fill_color'>[kuAccent]</set>
	<set xpath='//iconbutton[@color_selected="228,18,21,255"]/@color_selected'>111,227,255,255</set>
	<set xpath='//label[@color="228, 18, 21, 255"]/@color'>111,227,255,255</set>
	<set xpath='//label[@color="[red]"]/@color'>[kuAccent]</set>
	<set xpath='//mainmenubutton[@color_hovered="228,18,21,255"]/@color_hovered'>111,227,255,255</set>
	<set xpath='//mainmenubutton[@text_color_hovered="228,18,21,255"]/@text_color_hovered'>111,227,255,255</set>
	<set xpath='//rect[@color_changed="228,18,21,255"]/@color_changed'>111,227,255,255</set>
	<set xpath='//scrollbar[@thumb_color_active="179, 11, 11, 255"]/@thumb_color_active'>111,227,255,255</set>
	<set xpath='//scrollbar[@thumb_color_hover="179, 11, 11, 255"]/@thumb_color_hover'>111,227,255,255</set>
	<set xpath='//scrollbar[@thumb_color_inactive="179, 11, 11, 255"]/@thumb_color_inactive'>111,227,255,255</set>
	<set xpath='//servers_list_entry[@color_fav_selected="228,18,21,255"]/@color_fav_selected'>111,227,255,255</set>
	<set xpath='//sprite[@color="228, 18, 21, 255"]/@color'>30,84,118,255</set>
	<set xpath='//sprite[@color="228,18,21,255"]/@color'>30,84,118,255</set>
	<set xpath="//sprite[@color=&quot;{% !btn_enabled ? color(64,64,64,255) : (defined('btn_selected') and btn_selected ? color(228, 18, 21, 255) : (btn_hovered ? color(255, 255, 255, 255) : color(255, 255, 255, 255) ) ) }&quot;]/@color">{% !btn_enabled ? color(64,64,64,255) : (defined('btn_selected') and btn_selected ? color(30,84,118,255) : (btn_hovered ? color(255, 255, 255, 255) : color(255, 255, 255, 255) ) ) }</set>
	<set xpath='//sprite[@color="{% !hasentry ? color(0,0,0,0) : (isselected ? color(228, 18, 21, 255) : (hovered ? color(255,255,255,255) : color(0,0,0,0) ) ) }"]/@color'>{% !hasentry ? color(0,0,0,0) : (isselected ? color(30,84,118,255) : (hovered ? color(255,255,255,255) : color(0,0,0,0) ) ) }</set>
	<set xpath="//sprite[@color=&quot;{% defined('option_hovered') and option_hovered ? '228, 18, 21, 255' : '64,64,64,255' }&quot;]/@color">{% defined('option_hovered') and option_hovered ? '111,227,255,255' : '64,64,64,255' }</set>
	<set xpath="//sprite[@color=&quot;{% option_hovered ? '228, 18, 21, 180' : '0,0,0,0' }&quot;]/@color">{% option_hovered ? '30,84,118,180' : '0,0,0,0' }</set>
	<set xpath="//sprite[@color=&quot;{% option_hovered ? '228, 18, 21, 255' : '64,64,64,255' }&quot;]/@color">{% option_hovered ? '111,227,255,255' : '64,64,64,255' }</set>
	<!-- ===== END GENERATED ===== -->


	<!-- ================================================================ -->
	<!-- Options screens (also opened from the in-game Esc menu)          -->
	<!-- Rows: rounded, a faint edge idle, fox-fire ring + teal on hover. -->
	<!-- Key bindings: the binding field is a dark well.                  -->
	<!-- ================================================================ -->
	<set xpath="/templates/options_combo/rect/sprite[@name='border']/@sprite">ku_round_md_ring</set>
	<set xpath="/templates/options_combo/rect/sprite[@name='border']/@color">{% option_hovered ? '111,227,255,255' : '150,175,255,28' }</set>
	<set xpath="/templates/options_combo/rect/sprite[@name='background']/@sprite">ku_round_md</set>
	<set xpath="/templates/options_combo/rect/sprite[@name='background']/@color">{% option_hovered ? '30,84,118,200' : '255,255,255,8' }</set>
	<set xpath="/templates/keyboard_binding_entry/rect/sprite[@name='border']/@sprite">ku_round_md_ring</set>
	<set xpath="/templates/keyboard_binding_entry/rect/sprite[@name='border']/@color">{% defined('option_hovered') and option_hovered ? '111,227,255,255' : '150,175,255,28' }</set>
	<set xpath="/templates/keyboard_binding_entry/rect/iconbutton[@name='background']/@sprite">ku_round_sm</set>
	<set xpath="/templates/keyboard_binding_entry/rect/iconbutton[@name='background']/@color_default">[kuSlotWell]</set>
	<set xpath="/templates/keyboard_binding_entry/rect/iconbutton[@name='background']/@color_hovered">[kuBtnHover]</set>

	<!-- Description column: gold caption, and the 2 px separator becomes a faint edge  -->
	<!-- (the glass body behind list and description is in windows.xml).              -->
	<set xpath="/templates/options_descriptions/rect/label[@name='caption']/@color">[kuGold]</set>
	<set xpath="/templates/options_separator/sprite[@name='separator']/@color">[kuEdge]</set>
	<set xpath="/templates/options_scrollbar/scrollbar/@border_color_active">[kuEdge]</set>
	<set xpath="/templates/options_scrollbar/scrollbar/@border_color_inactive">[kuEdge]</set>

	<!-- Respawn screen, "spawn near friend" rows: no black frame; why a spot can't be used in danger red. -->
	<set xpath="/templates/spawnnearfriends_list_entry/rect/sprite[@name='backgroundMain']/@color">[transparent]</set>
	<set xpath="/templates/spawnnearfriends_list_entry/rect/label[@name='NotValidReason']/@color">[kuDanger]</set>

	<!-- Paging header (OPTIONS and its tabs): gold page name, fox-fire line under the open tab. -->
	<setattribute xpath="/templates/menu_paging_header/rect/label[@name='menuName']" name="color">[kuGold]</setattribute>
	<set xpath="/templates/pagingheader_subheaderline/sprite[@name='subheader_line']/@color">[kuAccentGlow]</set>

</configs>
