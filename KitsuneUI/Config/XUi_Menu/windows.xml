<configs>

	<!-- ===== GENERATED by tools/gen_menu_recolor.py: vanilla red -> Kitsunebi. Do not edit by hand. ===== -->
	<set xpath='//boxbg[@bordercolor="228, 18, 21, 255"]/@bordercolor'>111,227,255,255</set>
	<set xpath='//boxbg[@bordercolor="228,18,21,255"]/@bordercolor'>111,227,255,255</set>
	<set xpath='//boxshadow[@color="228, 18, 21, 170"]/@color'>111,227,255,170</set>
	<set xpath='//boxshadow_new[@color="228, 18, 21, 170"]/@color'>111,227,255,170</set>
	<set xpath='//boxshadow_new[@color="228,18,21,170"]/@color'>111,227,255,170</set>
	<set xpath='//boxshadow_new[@color="228,18,21,200"]/@color'>111,227,255,200</set>
	<set xpath='//headerbox[@backcolor="228,18,21,128"]/@backcolor'>30,84,118,128</set>
	<set xpath='//headerbox[@bordercolor="228,18,21,255"]/@bordercolor'>111,227,255,255</set>
	<set xpath='//iconbutton[@color_selected="228,18,21,255"]/@color_selected'>111,227,255,255</set>
	<set xpath='//label[@color="228, 18, 21, 255"]/@color'>111,227,255,255</set>
	<set xpath='//label[@color="228,18,21,255"]/@color'>111,227,255,255</set>
	<set xpath='//label[@color="[red]"]/@color'>[kuAccent]</set>
	<set xpath='//sprite[@color="228,18,21,200"]/@color'>30,84,118,200</set>
	<set xpath='//sprite[@color="228,18,21,255"]/@color'>30,84,118,255</set>
	<set xpath='//sprite[@color="[red]"]/@color'>[kuAccent]</set>
	<set xpath='//styledlabel[@textcolor="{% serverurlhovered ? color(228,18,21,255) : color(255,255,255,255) }"]/@textcolor'>{% serverurlhovered ? color(111,227,255,255) : color(255,255,255,255) }</set>
	<!-- ===== END GENERATED ===== -->


	<!-- ================================================================ -->
	<!-- Menu panels: vanilla uses boxes in near-black (16,16,16 / 0,0,0, -->
	<!-- some at 180 or 240 alpha) with grey or red borders. All of them  -->
	<!-- become the glass panel. Menus ignore Background Opacity.         -->
	<!-- ================================================================ -->
	<setattribute xpath="/windows/window//boxbg" name="backsprite">ku_panel</setattribute>
	<set xpath="/windows/window//boxbg[@backcolor]/@backcolor">[white]</set>
	<set xpath="/windows/window//boxbg[@bordercolor]/@bordercolor">[transparent]</set>
	<set xpath="/windows/window[@name='newContinueGameSettings']//sprite[@name='sprBackground']/@sprite">ku_panel</set>
	<set xpath="/windows/window[@name='newContinueGameSettings']//sprite[@name='sprBackground']/@color">[white]</set>
	<set xpath="/windows/window[@name='newContinueGameSettings']//sprite[@name='sprBorder']/@color">[transparent]</set>

	<!-- ================================================================ -->
	<!-- Options pages: night-indigo backdrop instead of black, and one   -->
	<!-- glass body behind the option list and the description column.    -->
	<!-- The list runs down to the Back / Defaults / Apply buttons, which -->
	<!-- are anchored to the screen bottom, so the body is anchored to    -->
	<!-- them too (as vanilla's scroll view is).                          -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='optionsPaging']/fullscreencollider/@color">8,10,24,250</set>
	<prepend xpath="/windows/window[.//options_descriptions]//rect[options_descriptions]">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" anchor_left="#parent,0,-14" anchor_right="#parent,0,1809" anchor_top="#parent,1,10" anchor_bottom="buttons,1,4" />
	</prepend>
	<set xpath="/windows/window[.//options_descriptions]//sprite[@name='separator']/@color">[kuEdge]</set>

	<!-- ================================================================ -->
	<!-- Loading screen ("side column"): the picture fills the screen,    -->
	<!-- centred on the part left of the column and cropped at the sides; -->
	<!-- the tip sits in a glass column down the right edge: a gold TIP   -->
	<!-- chip and the pager on top, then the gold title, a hairline and   -->
	<!-- the text. The bottom of the column is left for the spawn prompt. -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='loadingScreen']/fullscreencollider/@color">8,10,24,255</set>
	<set xpath="/windows/window[@name='loadingScreen']/texture[@name='loading_image']/@anchor_left">#cam,0,-800</set>
	<set xpath="/windows/window[@name='loadingScreen']/texture[@name='loading_image']/@anchor_right">#cam,1,240</set>
	<set xpath="/windows/window[@name='loadingScreen']/texture[@name='loading_image']/@anchor_bottom">#cam,0,-5</set>
	<remove xpath="/windows/window[@name='loadingScreen']/sprite[@name='backgroundMain']" />
	<remove xpath="/windows/window[@name='loadingScreen']/rect[@name='tips_enabled']" />
	<append xpath="/windows/window[@name='loadingScreen']">
		<sprite depth="4" name="kuColumnShade" sprite="ku_fade_r" type="sliced" color="0,0,0,120" globalopacitymod="0" anchor_left="#cam,1,-620" anchor_right="#cam,1,-560" anchor_bottom="#cam,0,-5" anchor_top="#cam,1,5" />
		<sprite depth="5" name="kuColumn" sprite="ku_panel" type="sliced" color="[white]" globalopacitymod="0" anchor_left="#cam,1,-560" anchor_right="#cam,1,40" anchor_bottom="#cam,0,-40" anchor_top="#cam,1,40" />
		<sprite depth="6" name="kuColumnEdge" sprite="ku_px" color="[kuGoldSoft]" globalopacitymod="0" anchor_left="#cam,1,-561" anchor_right="#cam,1,-560" anchor_bottom="#cam,0,-5" anchor_top="#cam,1,5" />

		<rect name="tips_enabled" visible="{show_tips}">
			<sprite depth="7" name="kuTipChip" sprite="ku_round_md_ring" type="sliced" color="[kuGoldSoft]" globalopacitymod="0" anchor_left="#cam,1,-530" anchor_right="#cam,1,-430" anchor_bottom="#cam,1,-84" anchor_top="#cam,1,-50" />
			<sprite depth="8" name="kuTipFlame" sprite="ku_icon_flame" color="[kuGold]" globalopacitymod="0" anchor_left="#cam,1,-520" anchor_right="#cam,1,-500" anchor_bottom="#cam,1,-77" anchor_top="#cam,1,-57" />
			<label depth="8" name="kuTipLabel" anchor_left="#cam,1,-496" anchor_right="#cam,1,-436" anchor_bottom="#cam,1,-84" anchor_top="#cam,1,-50" font_size="20" color="[kuGold]" justify="center" pivot="center" max_line_count="1" overflow="shrinkcontent" upper_case="true" text_key="kuTip" />

			<label name="lblLeft"  depth="8" anchor_left="#cam,1,-230" anchor_right="#cam,1,-180" anchor_bottom="#cam,1,-90" anchor_top="#cam,1,-44" font_size="28" color="[kuText]" pivot="center" justify="right" parse_actions="true" max_line_count="1" text=" [action:permanent:PageTipsBack]" />
			<label name="lblIndex" depth="8" anchor_left="#cam,1,-180" anchor_right="#cam,1,-80"  anchor_bottom="#cam,1,-90" anchor_top="#cam,1,-44" font_size="28" color="[kuTextBright]" pivot="center" justify="center" parse_actions="true" max_line_count="1" text="{index}/{count}" />
			<label name="lblRight" depth="8" anchor_left="#cam,1,-80"  anchor_right="#cam,1,-30"  anchor_bottom="#cam,1,-90" anchor_top="#cam,1,-44" font_size="28" color="[kuText]" pivot="center" justify="left" parse_actions="true" max_line_count="1" text="[action:permanent:PageTipsForward] " />

			<label name="lblTitle" depth="8" anchor_left="#cam,1,-530" anchor_right="#cam,1,-30" anchor_bottom="#cam,1,-170" anchor_top="#cam,1,-108" font_size="46" color="[kuGold]" pivot="left" justify="left" parse_actions="true" max_line_count="1" overflow="shrinkcontent" upper_case="true" text="{title}" />
			<sprite depth="8" name="kuRule" sprite="ku_rule" type="sliced" color="[kuGoldSoft]" globalopacitymod="0" anchor_left="#cam,1,-530" anchor_right="#cam,1,-30" anchor_bottom="#cam,1,-182" anchor_top="#cam,1,-180" />
			<label name="lblText"  depth="8" anchor_left="#cam,1,-530" anchor_right="#cam,1,-30" anchor_bottom="#cam,0,560" anchor_top="#cam,1,-200" font_size="28" color="[kuTextBright]" pivot="topleft" justify="left" parse_actions="true" overflow="shrinkcontent" actions_default_format="( [6FE3FF]###[-] )" spacing_y="6" text="{text}" />
		</rect>
	</append>

	<!-- Respawn screen: docked in the bottom of the loading column (bottom right). -->
	<!-- Its boxes are boxbg (glass above) and its buttons simplebuttons; the       -->
	<!-- "spawn near a friend" caption goes gold like other titles.                 -->
	<set xpath="/windows/window[@name='spawnselection']/@anchor">BottomRight</set>
	<set xpath="/windows/window[@name='spawnselection']/@pos">-530,380</set>
	<set xpath="/windows/window[@name='spawnselection']//label[@name='lblCaption']/@color">[kuGold]</set>

	<!-- ================================================================ -->
	<!-- News splash ("click to continue"): the news boxes are glass      -->
	<!-- cards (news_box template), and Continue is a fox-fire glass pill. -->
	<!-- The background, logo and copyright line are the game's own.      -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']/@sprite">ku_round_md</set>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']/@color">30,84,118,235</set>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']/@anchor_left">continueButtonLabelController,0,-70</set>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']/@anchor_right">continueButtonLabelController,1,70</set>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']/@anchor_bottom">continueButtonLabelController,0,-14</set>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']/@anchor_top">continueButtonLabelController,1,14</set>
	<insertAfter xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/sprite[@name='background']">
		<sprite depth="0" name="kuContinueRing" sprite="ku_round_md_ring" type="sliced" color="[kuAccent]" globalopacitymod="0" anchor_left="background,0,0" anchor_right="background,1,0" anchor_bottom="background,0,0" anchor_top="background,1,0" />
	</insertAfter>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/label/@color">[kuTextBright]</set>
	<set xpath="/windows/window[@name='newsScreen']/rect[@name='continue']/button[@name='btnContinue']/@hovercolor">111,227,255,60</set>

	<!-- ================================================================ -->
	<!-- Main menu ("side rail"): a full-height glass column on the left   -->
	<!-- edge of the screen at any width (16:9, ultrawide), holding the    -->
	<!-- logo, the buttons, then version and profile at its foot.          -->
	<!-- The news thumbnails move to the bottom right as glass cards, and  -->
	<!-- the background video fills the screen (no black bars).           -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='mainMenu']/@anchor">TopLeft</set>
	<set xpath="/windows/window[@name='mainMenu']/@pos">36,-40</set>
	<prepend xpath="/windows/window[@name='mainMenu']">
		<sprite depth="-2" name="kuRail" sprite="ku_panel_body" type="sliced" color="[white]" anchor_left="#cam,0,0" anchor_right="#cam,0,470" anchor_bottom="#cam,0,0" anchor_top="#cam,1,0" />
		<sprite depth="-1" name="kuRailEdge" sprite="ku_px" type="simple" color="[kuGoldSoft]" anchor_left="#cam,0,469" anchor_right="#cam,0,470" anchor_bottom="#cam,0,0" anchor_top="#cam,1,0" />
	</prepend>
	<set xpath="/windows/window[@name='mainMenu']/texture[@name='gameLogo']/@height">310</set>
	<set xpath="/windows/window[@name='mainMenu']/texture[@name='gameLogo']/@pos">105,0</set>
	<!-- Bigger rows that fill more of the rail; the list still clears the foot at 100% UI scale on a 1080 screen. -->
	<set xpath="/windows/window[@name='mainMenu']/grid/@pos">0,-360</set>
	<set xpath="/windows/window[@name='mainMenu']/grid/@cell_height">70</set>
	<set xpath="/windows/window[@name='mainMenu']/grid/@cell_width">398</set>
	<set xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton/@height">54</set>
	<setattribute xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnQuit']" name="text_color_default">255,179,168,255</setattribute>

	<!-- Version and profile: at the foot of the rail. -->
	<set xpath="/windows/window[@name='mainMenuVersion']/@anchor">BottomLeft</set>
	<set xpath="/windows/window[@name='mainMenuVersion']/@pos">54,140</set>
	<set xpath="/windows/window[@name='mainMenuVersion']/label[@name='version']/@font_size">20</set>
	<setattribute xpath="/windows/window[@name='mainMenuVersion']/label[@name='version']" name="color">[kuTextMuted]</setattribute>
	<append xpath="/windows/window[@name='mainMenuVersion']">
		<sprite depth="2" name="kuFootRule" sprite="ku_rule" type="sliced" color="[kuGoldSoft]" pos="0,22" width="380" height="2" />
	</append>
	<set xpath="/windows/window[@name='mainMenuPlayerName']/@anchor">BottomLeft</set>
	<set xpath="/windows/window[@name='mainMenuPlayerName']/@pos">54,104</set>
	<set xpath="/windows/window[@name='mainMenuPlayerName']/label/@font_size">20</set>
	<setattribute xpath="/windows/window[@name='mainMenuPlayerName']/label" name="color">[kuGold]</setattribute>
	<!-- (Discord stays where the game puts it: that window is open on every menu page, -->
	<!-- so moving it into the rail put it over Play Game's Back button.)               -->

	<!-- News thumbnails: glass cards in the bottom right, each with a fox-fire frame and a gold label strip under it, -->
	<!-- high enough to clear the Discord button (its window is the game's, open on every menu page).                  -->
	<set xpath="/windows/window[@name='mainMenuNews']/@anchor">BottomRight</set>
	<set xpath="/windows/window[@name='mainMenuNews']/@pos">-40,410</set>
	<set xpath="/windows/window[@name='mainMenuNews']/rect/sprite[@name='border']/@sprite">ku_round_md_ring</set>
	<set xpath="/windows/window[@name='mainMenuNews']/rect/sprite[@name='border']/@color">[kuAccentSoft]</set>
	<set xpath="/windows/window[@name='mainMenuNews']/rect/sprite[@name='border']/@depth">4</set>
	<append xpath="/windows/window[@name='mainMenuNews']/rect[@name='featured']">
		<sprite depth="5" name="kuNewsStrip" sprite="ku_panel_sm" type="sliced" color="[white]" anchor_left="#parent,0,0" anchor_right="#parent,1,0" anchor_top="#parent,0,-6" anchor_bottom="#parent,0,-40" />
		<label depth="6" name="kuNewsLabel" font_size="18" color="[kuGold]" upper_case="true" justify="center" pivot="center" text_key="xuiNewsHeaderFeatured" anchor_left="#parent,0,4" anchor_right="#parent,1,-4" anchor_top="#parent,0,-8" anchor_bottom="#parent,0,-38" />
	</append>
	<append xpath="/windows/window[@name='mainMenuNews']/rect[@name='game']">
		<sprite depth="5" name="kuNewsStrip" sprite="ku_panel_sm" type="sliced" color="[white]" anchor_left="#parent,0,0" anchor_right="#parent,1,0" anchor_top="#parent,0,-6" anchor_bottom="#parent,0,-40" />
		<label depth="6" name="kuNewsLabel" font_size="18" color="[kuGold]" upper_case="true" justify="center" pivot="center" text_key="xuiNewsHeaderGame" anchor_left="#parent,0,4" anchor_right="#parent,1,-4" anchor_top="#parent,0,-8" anchor_bottom="#parent,0,-38" />
	</append>
	<set xpath="/windows/window[@name='mainMenuNews']/rect/sprite[@name='background']/@sprite">ku_panel</set>
	<set xpath="/windows/window[@name='mainMenuNews']/rect/sprite[@name='background']/@color">[white]</set>

	<!-- The background video: fill the screen at any shape, cropping rather than letterboxing. -->
	<set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@anchor_left">#cam,0,0</set>
	<set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@anchor_right">#cam,1,0</set>
	<set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@anchor_bottom">#cam,0,0</set>
	<set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@anchor_top">#cam,1,0</set>
	<set xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']/@videoaspect">FitOutside</set>

	<!-- ================================================================ -->
	<!-- Join a game: the filters panel sits below the paging header's     -->
	<!-- band instead of running into it.                                 -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='serverBrowser']/panel[@name='serverfilters']/@pos">{# isprefilteredsearch ? -450 : 0},-56</set>
	<!-- Taller, with rows 46 apart instead of 50, so the Server tab (13 rows with its gaps) fits  -->
	<!-- without a scroll bar; the panel and its buttons still fit a 1080 screen at 100% UI scale. -->
	<!-- Basic and Advanced are longer than any screen and keep theirs.                         -->
	<set xpath="/windows/window[@name='serverBrowser']/panel[@name='serverfilters']/@height">850</set>
	<set xpath="/windows/window[@name='serverBrowser']/panel[@name='serverfilters']//scrollview/grid/@cell_height">46</set>

	<!-- Continue Game: taller rows for the save cards (savegames_list_entry), six to a page. -->
	<set xpath="/windows/window[@name='continueGame']/rect[@name='saves']/grid[@name='list']/@cell_height">96</set>
	<set xpath="/windows/window[@name='continueGame']/rect[@name='saves']/grid[@name='list']/@rows">6</set>
	<set xpath="/windows/window[@name='continueGame']/rect[@name='saves']/grid[@name='list']/@height">576</set>
</configs>
