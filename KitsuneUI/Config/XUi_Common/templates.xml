<configs>

	<!-- ===== GENERATED by tools/gen_menu_recolor.py: vanilla red -> Kitsunebi. Do not edit by hand. ===== -->
	<set xpath='//boxbg[@bordercolor="228, 18, 21, 255"]/@bordercolor'>111,227,255,255</set>
	<set xpath='//boxshadow_new[@color="228, 18, 21, 170"]/@color'>111,227,255,170</set>
	<set xpath='//boxshadow_new[@color="228,18,21,160"]/@color'>111,227,255,160</set>
	<set xpath='//button[@defaultcolor="200,0,0"]/@defaultcolor'>111,227,255</set>
	<set xpath='//defaultscrollbar[@thumb_color_active="179, 11, 11, 255"]/@thumb_color_active'>111,227,255,255</set>
	<set xpath='//defaultscrollbar[@thumb_color_hover="179, 11, 11, 255"]/@thumb_color_hover'>111,227,255,255</set>
	<set xpath='//headerbox[@bordercolor="228,18,21,255"]/@bordercolor'>111,227,255,255</set>
	<set xpath='//headerbox[@textcolor="228,18,21,255"]/@textcolor'>111,227,255,255</set>
	<set xpath='//headerboxicon[@bordercolor="228,18,21,255"]/@bordercolor'>111,227,255,255</set>
	<set xpath='//headerboxicon[@textcolor="228,18,21,255"]/@textcolor'>111,227,255,255</set>
	<set xpath='//iconbutton[@color_selected="228,18,21,180"]/@color_selected'>111,227,255,180</set>
	<set xpath='//label[@color="228,18,21,255"]/@color'>111,227,255,255</set>
	<set xpath='//sprite[@color="228, 18, 21, 255"]/@color'>111,227,255,255</set>
	<set xpath='//sprite[@color="228, 18, 21, 70"]/@color'>30,84,118,70</set>
	<set xpath='//sprite[@color="228,18,21,255"]/@color'>111,227,255,255</set>
	<set xpath='//sprite[@color="{% !hasentry ? color(0,0,0,0) : (isselected ? color(228, 18, 21, 180) : (hovered ? color(96,96,96,255) : color(20,20,20,255) ) ) }"]/@color'>{% !hasentry ? color(0,0,0,0) : (isselected ? color(30,84,118,180) : (hovered ? color(96,96,96,255) : color(20,20,20,255) ) ) }</set>
	<set xpath='//sprite[@color="{% !hasentry ? color(0,0,0,0) : (isselected ? color(228, 18, 21, 255) : (hovered ? color(255,255,255,255) : color(0,0,0,0) ) ) }"]/@color'>{% !hasentry ? color(0,0,0,0) : (isselected ? color(30,84,118,255) : (hovered ? color(255,255,255,255) : color(0,0,0,0) ) ) }</set>
	<!-- ===== END GENERATED ===== -->


	<!-- Window headers. headerbg draws ui_game_panel_header, which this mod replaces with -->
	<!-- a glass header (rounded top, gold divider). The colour is baked into the image, so -->
	<!-- draw it untinted, and let it follow the Background Opacity setting like the body.  -->
	<set xpath="/templates/headerbg/@backcolor">[white]</set>
	<set xpath="/templates/headerbg/@globalopacitymod">1</set>

	<!-- ================================================================ -->
	<!-- Header boxes (popup titles, many menu section titles)           -->
	<!-- Vanilla: black box, red 2px border, red text. Ours: the glass    -->
	<!-- header with a gold title. Callers that pass their own colours    -->
	<!-- keep them, drawn over the glass.                                 -->
	<!-- ================================================================ -->
	<set xpath="/templates/*[self::headerbox or self::headerboxicon]/@backcolor">[white]</set>
	<set xpath="/templates/*[self::headerbox or self::headerboxicon]/@bordercolor">[transparent]</set>
	<set xpath="/templates/*[self::headerbox or self::headerboxicon]/@textcolor">[kuGold]</set>
	<setattribute xpath="/templates/*[self::headerbox or self::headerboxicon]/rect/boxbg" name="backsprite">ui_game_panel_header</setattribute>

	<!-- ================================================================ -->
	<!-- Hover tooltip: vanilla is a white-edged grey box. Ours: a dark   -->
	<!-- rounded chip with a faint edge, over a soft shadow.              -->
	<!-- ================================================================ -->
	<set xpath="/templates/tooltip/window/rect/sprite[@name='sprBackgroundShadow']/@sprite">ku_round_md</set>
	<set xpath="/templates/tooltip/window/rect/sprite[@name='sprBackgroundBorder']/@sprite">ku_round_md</set>
	<set xpath="/templates/tooltip/window/rect/sprite[@name='sprBackgroundBorder']/@color">[kuEdge]</set>
	<set xpath="/templates/tooltip/window/rect/sprite[@name='sprBackground']/@sprite">ku_round_md</set>
	<set xpath="/templates/tooltip/window/rect/sprite[@name='sprBackground']/@color">[kuHudTrack]</set>

	<!-- ================================================================ -->
	<!-- Right-click / context popup menu: a glass panel instead of a     -->
	<!-- grey outline over near-black rows, a gold title on a gold cell,  -->
	<!-- rounded rows that light teal on hover. The drop shadow stays.    -->
	<!-- ================================================================ -->
	<set xpath="/templates/popupMenu/window/sprite[@name='sprBackgroundBorder']/@sprite">ku_panel</set>
	<set xpath="/templates/popupMenu/window/sprite[@name='sprBackgroundBorder']/@fillcenter">true</set>
	<set xpath="/templates/popupMenu/window/sprite[@name='sprBackgroundBorder']/@color">[white]</set>
	<set xpath="/templates/popupMenu/window/sprite[@name='sprBackgroundBorder']/@depth">1</set>
	<set xpath="/templates/popupMenu/window/rect[@name='header']/sprite[@name='sprBorder']/@color">[transparent]</set>
	<set xpath="/templates/popupMenu/window/rect[@name='header']/sprite[@name='sprBackground']/@sprite">ku_round_md</set>
	<set xpath="/templates/popupMenu/window/rect[@name='header']/sprite[@name='sprBackground']/@color">[kuCellHeader]</set>
	<set xpath="/templates/popupMenu/window/rect[@name='header']/label/@color">[kuGold]</set>
	<set xpath="/templates/popupMenu/window/rect[@name='content']/grid/rect/sprite[@name='background']/@sprite">ku_round_md</set>
	<set xpath="/templates/popupMenu/window/rect[@name='content']/grid/rect/sprite[@name='background']/@color">{# enabled and hovered ? '40,92,112,220' : '255,255,255,10' }</set>

	<!-- Text fields (search boxes, counts): a dark well instead of solid black. -->
	<set xpath="/templates/textfield/@backgroundcolor">[kuSlotWell]</set>

	<!-- ================================================================ -->
	<!-- Message box (notes, confirmations, warnings)                     -->
	<!-- ================================================================ -->
	<!-- Red glow around the box -> a soft fox-fire glow. -->
	<set xpath="/templates/messagebox/window/boxshadow_new/@color">111,227,255,70</set>
	<!-- Near-black body with a grey border -> the glass body under the glass header. -->
	<setattribute xpath="/templates/messagebox/window/rect[@name='content']/boxbg" name="backsprite">ku_panel_body</setattribute>
	<set xpath="/templates/messagebox/window/rect[@name='content']/boxbg/@backcolor">[white]</set>
	<set xpath="/templates/messagebox/window/rect[@name='content']/boxbg/@bordercolor">[transparent]</set>

	<!-- ================================================================ -->
	<!-- Buttons (labeledglyphbutton: popups, menus, dialogs)             -->
	<!-- Vanilla: black box with a white 2px border, grey on hover.       -->
	<!-- Ours: a rounded glass button with a cool edge, fox-fire on hover. -->
	<!-- ================================================================ -->
	<set xpath="/templates/labeledglyphbutton/@border_sprite">ku_round_md_ring</set>
	<set xpath="/templates/labeledglyphbutton/@border_color">[kuEdge]</set>
	<set xpath="/templates/labeledglyphbutton/@bg_sprite_default">ku_round_md</set>
	<set xpath="/templates/labeledglyphbutton/@bg_sprite_hovered">ku_round_md</set>
	<set xpath="/templates/labeledglyphbutton/@bg_sprite_selected">ku_round_md</set>
	<set xpath="/templates/labeledglyphbutton/@bg_sprite_disabled">ku_round_md</set>
	<set xpath="/templates/labeledglyphbutton/@bg_color_default">[kuBtn]</set>
	<set xpath="/templates/labeledglyphbutton/@bg_color_hovered">[kuBtnHover]</set>
	<set xpath="/templates/labeledglyphbutton/@bg_color_selected">[kuBtnHover]</set>
	<set xpath="/templates/labeledglyphbutton/@bg_color_disabled">[kuBtnDisabled]</set>
	<set xpath="/templates/labeledglyphbutton/@font_color_default">[kuText]</set>
	<set xpath="/templates/labeledglyphbutton/@font_color_hovered">[kuTextBright]</set>
	<set xpath="/templates/labeledglyphbutton/@font_color_selected">[kuTextBright]</set>
	<set xpath="/templates/labeledglyphbutton/@font_color_disabled">[kuTextMuted]</set>
	<!-- simplebutton (Apply / Remove All in the cosmetics screen, and many others):    -->
	<!-- vanilla flat grey with a black edge, and tan (ui_game_select_row) on hover.    -->
	<set xpath="/templates/simplebutton/@bordersprite">ku_round_md_ring</set>
	<set xpath="/templates/simplebutton/@bordercolor">[kuEdge]</set>
	<set xpath="/templates/simplebutton/@defaultsprite">ku_round_md</set>
	<set xpath="/templates/simplebutton/@defaultcolor">[kuBtn]</set>
	<set xpath="/templates/simplebutton/@hoversprite">ku_round_md</set>
	<set xpath="/templates/simplebutton/@hovercolor">[kuBtnHover]</set>
	<set xpath="/templates/simplebutton/@selectedsprite">ku_round_md</set>
	<set xpath="/templates/simplebutton/@selectedcolor">[kuBtnHover]</set>
	<set xpath="/templates/simplebutton/rect/button[@name='clickable']/@disabledcolor">[kuBtnDisabled]</set>

	<!-- labeledbutton (Manage Saves, Delete Save, Sandbox Options, ...): vanilla black box -->
	<!-- with a white 2px border. Same glass button as labeledglyphbutton.                   -->
	<set xpath="/templates/labeledbutton/@border_sprite">ku_round_md_ring</set>
	<set xpath="/templates/labeledbutton/@border_color">[kuEdge]</set>
	<set xpath="/templates/labeledbutton/@bg_sprite_default">ku_round_md</set>
	<set xpath="/templates/labeledbutton/@bg_sprite_hovered">ku_round_md</set>
	<set xpath="/templates/labeledbutton/@bg_sprite_selected">ku_round_md</set>
	<set xpath="/templates/labeledbutton/@bg_sprite_disabled">ku_round_md</set>
	<set xpath="/templates/labeledbutton/@bg_color_default">[kuBtn]</set>
	<set xpath="/templates/labeledbutton/@bg_color_hovered">[kuBtnHover]</set>
	<set xpath="/templates/labeledbutton/@bg_color_selected">[kuBtnHover]</set>
	<set xpath="/templates/labeledbutton/@bg_color_disabled">[kuBtnDisabled]</set>
	<set xpath="/templates/labeledbutton/@font_color_default">[kuText]</set>
	<set xpath="/templates/labeledbutton/@font_color_hovered">[kuTextBright]</set>
	<set xpath="/templates/labeledbutton/@font_color_selected">[kuTextBright]</set>
	<set xpath="/templates/labeledbutton/@font_color_disabled">[kuTextMuted]</set>
	<set xpath="/templates/labeledbutton/rect/sprite[@name='fill']/@sprite">ku_round_md</set>
	<set xpath="/templates/labeledbutton/rect/sprite[@name='fill']/@color">[kuAccentSoft]</set>

	<!-- Search box (captionedtextbox): black box, white border -> dark well, cool edge. -->
	<set xpath="/templates/captionedtextbox/@border_sprite">ku_round_md_ring</set>
	<set xpath="/templates/captionedtextbox/@border_color">[kuEdge]</set>
	<set xpath="/templates/captionedtextbox/@bg_sprite_default">ku_round_md</set>
	<set xpath="/templates/captionedtextbox/@bg_sprite_hovered">ku_round_md</set>
	<set xpath="/templates/captionedtextbox/@bg_sprite_disabled">ku_round_md</set>
	<set xpath="/templates/captionedtextbox/@bg_color_default">[kuSlotWell]</set>
	<set xpath="/templates/captionedtextbox/@bg_color_hovered">[kuBtnHover]</set>
	<set xpath="/templates/captionedtextbox/@bg_color_disabled">[kuBtnDisabled]</set>

	<!-- Combo boxes (Group / Preset and every option row): black box -> dark well. -->
	<set xpath="/templates/combobox/@bg_color">[kuSlotWell]</set>
	<setattribute xpath="/templates/combobox/rect/rect[@name='fills']/rect[@name='regularFill']/sprite[@name='background']" name="sprite">ku_round_sm</setattribute>
	<!-- Value boxes (combo boxes, text fields): one rounded glass well with a matching rounded   -->
	<!-- edge, instead of a rounded fill inside a square grey border (64,64,64 on the menus).    -->
	<set xpath="/templates/combobox/rect/rect[@name='fills']/sprite[@name='border']/@sprite">ku_round_md_ring</set>
	<set xpath="/templates/combobox/rect/rect[@name='fills']/sprite[@name='border']/@color">[kuEdge]</set>
	<setattribute xpath="/templates/textfield/rect/sprite[@name='background']" name="sprite">ku_round_sm</setattribute>
	<setattribute xpath="/templates/textfield/rect/sprite[@name='border']" name="sprite">ku_round_md_ring</setattribute>
	<set xpath="/templates/textfield/rect/sprite[@name='border']/@color">[kuEdge]</set>
	<!-- Read-only value boxes (styledlabel: New game's World Size, server info): the same well.  -->
	<!-- Their fill and text sit INSIDE the border sprite, and NGUI multiplies a child's alpha by -->
	<!-- its parent's, so the border must stay opaque: 55,65,104 is kuEdge's look over the glass. -->
	<set xpath="/templates/styledlabel/@backgroundcolor">[kuSlotWell]</set>
	<set xpath="/templates/styledlabel/@bordercolor">55,65,104,255</set>
	<set xpath="/templates/styledlabel/@bordersprite">ku_round_md_ring</set>
	<set xpath="/templates/styledlabel/sprite/sprite[@name='background']/@sprite">ku_round_sm</set>
	<!-- A show/hide switch for these boxes (vanilla has none); on by default. -->
	<setattribute xpath="/templates/styledlabel" name="visible">true</setattribute>
	<setattribute xpath="/templates/styledlabel/sprite" name="visible">${visible}</setattribute>
	<set xpath="/templates/combobox/rect/rect[@name='fills']/rect[@name='regularFill']/sprite[@name='fillBg']/@color">[kuTrack]</set>
	<!-- Toggle buttons (Filter small POIs, debug toggles, ...): glass button, dark-well -->
	<!-- tick box with a fox-fire tick. Vanilla: grey box, tan on hover, black edge.     -->
	<set xpath="/templates/togglebutton/rect/button[@name='clickable']/@sprite">ku_round_md</set>
	<set xpath="/templates/togglebutton/rect/button[@name='clickable']/@defaultcolor">[kuBtn]</set>
	<set xpath="/templates/togglebutton/rect/button[@name='clickable']/@disabledcolor">[kuBtnDisabled]</set>
	<set xpath="/templates/togglebutton/rect/button[@name='clickable']/@hoversprite">ku_round_md</set>
	<set xpath="/templates/togglebutton/rect/button[@name='clickable']/@hovercolor">[kuBtnHover]</set>
	<set xpath="/templates/togglebutton/rect/sprite[@name='border']/@sprite">ku_round_md_ring</set>
	<set xpath="/templates/togglebutton/rect/sprite[@name='border']/@color">[kuEdge]</set>
	<set xpath="/templates/togglebutton/rect/sprite[@name='tickbox']/@sprite">ku_round_sm</set>
	<set xpath="/templates/togglebutton/rect/sprite[@name='tickbox']/@color">[kuSlotWell]</set>
	<set xpath="/templates/togglebutton/rect/sprite[@name='tickmark']/@color">[kuAccent]</set>

	<!-- Hold-to-activate progress fill -->
	<set xpath="/templates/labeledglyphbutton/rect/sprite[@name='fill']/@sprite">ku_round_md</set>
	<set xpath="/templates/labeledglyphbutton/rect/sprite[@name='fill']/@color">[kuAccentSoft]</set>

	<!-- ================================================================ -->
	<!-- Framework building blocks (public, see docs/framework.md). Other -->
	<!-- mods use these inside mod_loaded('KitsuneUI') conditionals.      -->
	<!-- ================================================================ -->
	<append xpath="/templates">
		<!-- The glass body under a vanilla header (headerbg, 43 tall), filling the window below it. -->
		<!-- Glass strength and colour follow the player's settings.                                -->
		<ku_window_body name="kuBody" depth="-1" top="40">
			<sprite name="${name}" depth="${depth}" sprite="ku_panel_body" type="sliced" color="[white]"
				pos="0,-${top}" width="${parentinnerwidth}" height="${parentinnerheight - top}" />
		</ku_window_body>

		<!-- A gold section title with a rule under it. -->
		<ku_section name="kuSection" pos="0,0" width="300" depth="3" font_size="24" text="" text_key="">
			<rect name="${name}" pos="${pos}" width="${width}" height="34" depth="${depth}">
				<label depth="${depth}" pos="0,0" width="${width}" height="30" font_size="${font_size}" justify="left"
					color="[kuGold]" effect="outline" effect_color="0,0,0,160" text="${text}" text_key="${text_key}" />
				<sprite depth="${depth}" pos="0,-31" width="${width}" height="2" sprite="ku_rule" type="sliced" color="[kuGoldSoft]" />
			</rect>
		</ku_section>

		<!-- A rounded cell, for table rows and info blocks; alt="true" for the alternate rows. -->
		<ku_row name="kuRow" pos="0,0" width="300" height="34" depth="1" alt="false">
			<sprite name="${name}" depth="${depth}" pos="${pos}" width="${width}" height="${height}"
				sprite="ku_round_sm" type="sliced" color="${alt ? '[kuCellAlt]' : '[kuCell]'}" />
		</ku_row>

		<!-- A glass toggle with its label, like the KitsuneUI settings window. The label's id is -->
		<!-- the toggle's name plus "Text".                                                      -->
		<ku_toggle_row name="kuToggle" pos="0,0" width="520" depth="3" font_size="26" text="" text_key="">
			<rect pos="${pos}" width="${width}" height="40">
				<togglebutton name="${name}" depth="${depth}" pos="0,0" width="${width}" height="40" font_size="${font_size}" caption="" />
				<label depth="${depth + 1}" name="${name}Text" pos="46,-20" width="${width - 54}" height="34" pivot="left"
					font_size="${font_size}" overflow="shrinkcontent" color="[kuText]" effect="outline" effect_color="0,0,0,160"
					text="${text}" text_key="${text_key}" />
			</rect>
		</ku_toggle_row>
	</append>
</configs>
