<configs>

	<!-- ===== GENERATED by tools/gen_menu_recolor.py: vanilla red -> Kitsunebi. Do not edit by hand. ===== -->
	<set xpath='//style_entry[@value="{% !hasentry ? color(0,0,0,0) : (isselected ? color(228, 18, 21, 180) : (hovered ? color(96,96,96,255) : color(0,0,0,0) ) ) }"]/@value'>{% !hasentry ? color(0,0,0,0) : (isselected ? color(30,84,118,180) : (hovered ? color(96,96,96,255) : color(0,0,0,0) ) ) }</set>
	<set xpath='//style_entry[@value="{% !hasentry ? color(0,0,0,0) : (isselected ? color(228, 18, 21, 255) : (hovered ? color(255,255,255,255) : color(64,64,64,255) ) ) }"]/@value'>{% !hasentry ? color(0,0,0,0) : (isselected ? color(111,227,255,255) : (hovered ? color(255,255,255,255) : color(64,64,64,255) ) ) }</set>
	<!-- ===== END GENERATED ===== -->


	<!-- ================================================================ -->
	<!-- Kitsunebi palette                                                -->
	<!-- The ku* entries are ours; windows we restyle use them. Change    -->
	<!-- kuAccent to recolour every selection, glow and active tab.       -->
	<!-- ================================================================ -->
	<append xpath="/styles/global">
		<style_entry name="kuAccent"       value="111,227,255,255" />  <!-- fox-fire cyan -->
		<style_entry name="kuAccentSoft"   value="111,227,255,64" />
		<style_entry name="kuAccentGlow"   value="111,227,255,140" />
		<style_entry name="kuGold"         value="217,184,115,255" />  <!-- titles, hairlines -->
		<style_entry name="kuGoldSoft"     value="217,184,115,90" />
		<style_entry name="kuText"         value="232,236,247,255" />
		<style_entry name="kuTextBright"   value="242,245,252,255" />
		<style_entry name="kuTextMid"      value="195,202,224,255" />
		<style_entry name="kuTextMuted"    value="154,163,191,255" />
		<style_entry name="kuIcon"         value="201,211,238,255" />
		<style_entry name="kuEdge"         value="150,175,255,70" />   <!-- slot and button outlines -->
		<style_entry name="kuSlotWell"     value="6,8,20,150" />       <!-- empty-slot fill: a dark well that reads over day and night -->
		<style_entry name="kuSlotLocked"   value="80,18,28,190" />     <!-- slots past carry capacity -->
		<style_entry name="kuCosmeticOwned" value="34,104,132,215" />  <!-- cosmetics you own: fox-fire teal well -->
		<style_entry name="kuCosmeticVeil"  value="6,8,20,170" />      <!-- dims a locked cosmetic's icon -->
		<style_entry name="kuEdgeFaint"    value="150,175,255,20" />
		<style_entry name="kuFill"         value="255,255,255,12" />   <!-- slot and button fill -->
		<style_entry name="kuFillEmpty"    value="255,255,255,5" />
		<style_entry name="kuFillHover"    value="255,255,255,26" />
		<style_entry name="kuTrack"        value="255,255,255,20" />   <!-- empty part of bars -->
		<style_entry name="kuCell"         value="255,255,255,14" />   <!-- table cells, info blocks -->
		<style_entry name="kuCellAlt"      value="255,255,255,7" />    <!-- alternate stat rows -->
		<style_entry name="kuCellHeader"   value="217,184,115,36" />   <!-- table header cells (gold) -->
		<style_entry name="kuRowGrey"      value="64,64,64,255" />     <!-- the grey code uses for an idle row; times ku_row = navy -->
		<style_entry name="kuBtn"          value="18,22,44,200" />     <!-- button fill -->
		<style_entry name="kuBtnHover"     value="40,92,112,220" />    <!-- button fill on hover: fox-fire over indigo -->
		<style_entry name="kuBtnDisabled"  value="18,22,44,110" />
		<style_entry name="kuBtnGood"      value="34,92,52,225" />     <!-- Accept -->
		<style_entry name="kuBtnGoodHover" value="58,140,78,240" />
		<style_entry name="kuBtnBad"       value="104,30,36,225" />    <!-- Decline -->
		<style_entry name="kuBtnBadHover"  value="156,48,52,240" />
		<style_entry name="kuHudTrack"     value="14,16,32,252" />     <!-- HUD bar track: near-solid, so the injury hatch under it never leaks through -->
		<style_entry name="kuHatch"        value="255,107,90,190" />   <!-- injury hatch on stat bars -->
		<style_entry name="kuHudFade"      value="12,14,30,215" />     <!-- fading glass behind the quest / recipe trackers -->
		<style_entry name="kuHealth"       value="255,107,90,255" />
		<style_entry name="kuStamina"      value="242,181,68,255" />
		<style_entry name="kuFood"         value="155,211,106,255" />
		<style_entry name="kuWater"        value="89,180,255,255" />
		<style_entry name="kuXP"           value="180,140,255,255" />
		<style_entry name="kuGood"         value="111,210,102,255" />
		<style_entry name="kuDanger"       value="255,107,90,255" />
	</append>

	<!-- Vanilla globals that most windows (and other mods' windows) draw with. Moving them -->
	<!-- onto the indigo/cyan palette makes windows we haven't rebuilt sit in the theme too. -->
	<set xpath="/styles/global/style_entry[@name='darkestGrey']/@value">10,12,24,255</set>
	<set xpath="/styles/global/style_entry[@name='darkGrey']/@value">22,26,48,255</set>
	<set xpath="/styles/global/style_entry[@name='mediumGrey']/@value">40,46,78,255</set>
	<set xpath="/styles/global/style_entry[@name='lightGrey']/@value">110,118,150,255</set>
	<set xpath="/styles/global/style_entry[@name='lightestGrey']/@value">154,163,191,255</set>
	<set xpath="/styles/global/style_entry[@name='borderColor']/@value">6,8,16,255</set>
	<set xpath="/styles/global/style_entry[@name='mediumGrey_half_alpha']/@value">40,46,78,128</set>
	<set xpath="/styles/global/style_entry[@name='darkGrey_half_alpha']/@value">22,26,48,128</set>
	<set xpath="/styles/global/style_entry[@name='labelColor']/@value">232,236,247,255</set>
	<set xpath="/styles/global/style_entry[@name='iconColor']/@value">201,211,238,255</set>
	<set xpath="/styles/global/style_entry[@name='selectedColor']/@value">111,227,255,255</set>
	<set xpath="/styles/global/style_entry[@name='hoverColor']/@value">217,184,115,255</set>
	<set xpath="/styles/global/style_entry[@name='disabledColor']/@value">110,118,150,255</set>
	<!-- Lighter than the other greys so it still reads on the deep-teal selected row. -->
	<set xpath="/styles/global/style_entry[@name='disabledLabelColor']/@value">160,168,196,255</set>

	<!-- Window titles gold, window icons fox-fire, for every window built on the standard   -->
	<!-- header styles (vanilla sets no colour, so titles were plain white). A label or icon -->
	<!-- with its own color attribute keeps it.                                             -->
	<append xpath="/styles/style[@name='header.name' or @name='header.name.shrink' or @name='header.name.iconright']">
		<style_entry name="color" value="[kuGold]" />
	</append>
	<append xpath="/styles/style[@name='header.icon']">
		<style_entry name="color" value="[kuAccent]" />
	</append>
	<append xpath="/styles/style[@name='header.timer']">
		<style_entry name="color" value="[kuTextMid]" />
	</append>
	<set xpath="/styles/style[@name='workstation.reserve.weight']/style_entry[@name='color']/@value">[kuTextMid]</set>
	<set xpath="/styles/style[@name='crafting.info.window']/style_entry[@name='valid_color']/@value">[kuGood]</set>
	<set xpath="/styles/style[@name='crafting.info.window']/style_entry[@name='invalid_color']/@value">[kuDanger]</set>

	<!-- ================================================================ -->
	<!-- List rows                                                        -->
	<!-- listentry.background_old (admin lists: POI teleport, spawn,      -->
	<!-- prefabs) swaps menu_empty / ui_game_select_row with 64 / 96 /    -->
	<!-- white greys, like the recipe rows: point it at KitsuneRows.      -->
	<!-- listentry.background / .border (save list, server browser...):   -->
	<!-- rounded, teal when selected, faint edge otherwise.               -->
	<!-- ================================================================ -->
	<append xpath="/styles/style[@name='listentry.background_old']">
		<style_entry name="atlas" value="KitsuneRows" />
	</append>
	<set xpath="/styles/style[@name='listentry.background']/style_entry[@name='sprite']/@value">ku_round_sm</set>
	<set xpath="/styles/style[@name='listentry.background']/style_entry[@name='color']/@value">{% !hasentry ? color(0,0,0,0) : (isselected ? color(30,84,118,235) : (hovered ? color(40,60,96,200) : color(0,0,0,0) ) ) }</set>
	<set xpath="/styles/style[@name='listentry.border']/style_entry[@name='sprite']/@value">ku_round_md_ring</set>
	<set xpath="/styles/style[@name='listentry.border']/style_entry[@name='color']/@value">{% !hasentry ? color(0,0,0,0) : (isselected ? color(111,227,255,255) : (hovered ? color(217,184,115,200) : color(150,175,255,40) ) ) }</set>

	<!-- ================================================================ -->
	<!-- Top tab bar (paging header over the character / crafting / map  -->
	<!-- windows) and the workstation title bar (nonpaging header).       -->
	<!-- Vanilla: grey header fill in a black border, black name inset.   -->
	<!-- Ours: a glass strip, the window name on a soft cell.             -->
	<!-- ================================================================ -->
	<set xpath="/styles/style[@name='paging.window.background.border' or @name='nonpaging.window.background.border' or @name='twitch.paging.window.background.border']/style_entry[@name='color']/@value">[transparent]</set>
	<set xpath="/styles/style[@name='paging.window.background' or @name='nonpaging.window.background' or @name='twitch.paging.window.background']/style_entry[@name='sprite']/@value">ku_panel</set>
	<set xpath="/styles/style[@name='paging.window.background' or @name='nonpaging.window.background' or @name='twitch.paging.window.background']/style_entry[@name='color']/@value">[white]</set>
	<set xpath="/styles/style[@name='paging.window.name.background' or @name='nonpaging.window.name.background' or @name='twitch.paging.window.name.background']/style_entry[@name='sprite']/@value">ku_round_md</set>
	<set xpath="/styles/style[@name='paging.window.name.background' or @name='nonpaging.window.name.background' or @name='twitch.paging.window.name.background']/style_entry[@name='color']/@value">[kuCell]</set>
	<set xpath="/styles/style[@name='paging.window.name.foreground' or @name='nonpaging.window.name.foreground' or @name='twitch.paging.window.name.foreground']/style_entry[@name='color']/@value">[transparent]</set>

	<!-- Item slot colours. The slot ring and glow take select_color when selected,  -->
	<!-- highlight_color on hover, holding_color for the held toolbelt slot and      -->
	<!-- background_color otherwise; the fill is always background_color.            -->
	<set xpath="/styles/style[@name='itemStack' or @name='signStack' or @name='vehicleStack' or @name='itemPartStack']/style_entry[@name='select_color']/@value">[kuAccent]</set>
	<set xpath="/styles/style[@name='itemStack' or @name='signStack' or @name='vehicleStack' or @name='itemPartStack']/style_entry[@name='highlight_color']/@value">[kuGold]</set>
	<set xpath="/styles/style[@name='itemStack' or @name='signStack' or @name='vehicleStack' or @name='itemPartStack']/style_entry[@name='holding_color']/@value">[kuAccent]</set>
	<set xpath="/styles/style[@name='itemStack' or @name='signStack' or @name='vehicleStack' or @name='itemPartStack']/style_entry[@name='background_color']/@value">[kuSlotWell]</set>
	<!-- Locked slots (vanilla: flat 48,48,48 grey) get a dark red tint. -->
	<append xpath="/styles/style[@name='itemStack' or @name='signStack' or @name='vehicleStack' or @name='itemPartStack']">
		<style_entry name="attribute_lock_color" value="[kuSlotLocked]" />
	</append>
</configs>
