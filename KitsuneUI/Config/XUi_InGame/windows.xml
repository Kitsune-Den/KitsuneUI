<configs>

	<!-- Windows are restyled in place: elements keep their vanilla names, paths and grid  -->
	<!-- sizes, so mods that resize bags, containers and the toolbelt still patch them.    -->

	<!-- ================================================================ -->
	<!-- Backpack                                                         -->
	<!-- ================================================================ -->

	<!-- Glass body under the glass header; pulled up 3px so the two meet at the divider. -->
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='sprBackground']/@sprite">ku_panel_body</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='sprBackground']/@color">[white]</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='sprBackground']/@globalopacitymod">1</set>
	<setattribute xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='sprBackground']" name="pos">0,3</setattribute>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/sprite[@name='sprBorder']/@color">[transparent]</set>

	<setattribute xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/label[@name='windowName']" name="color">[kuGold]</setattribute>
	<setattribute xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/sprite[@name='windowIcon']" name="color">[kuAccent]</setattribute>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/sprite[@name='costIcon']/@color">[kuGold]</set>

	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/defaultscrollbar/@thumb_color_active">[kuAccent]</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/defaultscrollbar/@thumb_color_inactive">[kuTextMuted]</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/defaultscrollbar/@border_color_active">[transparent]</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/defaultscrollbar/@border_color_inactive">[transparent]</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/defaultscrollbar/@background_color_active">[kuTrack]</set>
	<set xpath="/windows/window[@name='windowBackpack']/rect[@name='content']/defaultscrollbar/@background_color_inactive">[kuTrack]</set>

	<!-- ================================================================ -->
	<!-- Loot containers                                                  -->
	<!-- ================================================================ -->

	<!-- Vanilla draws the header sprite unsliced (stretched); slice it so the corners stay round. -->
	<setattribute xpath="/windows/window[@name='windowLooting']/rect[@name='header']/sprite[@name='headerbackground']" name="type">sliced</setattribute>
	<setattribute xpath="/windows/window[@name='windowLooting']/rect[@name='header']/label[@name='lootName']" name="color">[kuGold]</setattribute>
	<setattribute xpath="/windows/window[@name='windowLooting']/rect[@name='header']/sprite[@name='windowIcon']" name="color">[kuAccent]</setattribute>

	<!-- Vanilla has no background behind the loot grid. Ours spans the header's width      -->
	<!-- (grid + scrollbar) and the visible rows, and starts 6px up so it meets the header. -->
	<prepend xpath="/windows/window[@name='windowLooting']/rect[@name='content']">
		<sprite depth="0" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,6"
			width="{% v2i_x(gridDimensions) * 75 + 19 }"
			height="{% Min( v2i_y(gridDimensions) * 75 + 3, 753 ) + 12 }" />
	</prepend>

	<!-- Vanilla's loot scrollview has no depth, which ties with kuBody (depth 0), and the body -->
	<!-- then draws over the slots: only foreground-layer item icons showed. The backpack gives -->
	<!-- its scrollview depth 2 over a depth-0 background; do the same here.                   -->
	<setattribute xpath="/windows/window[@name='windowLooting']/rect[@name='content']/scrollview" name="depth">2</setattribute>

	<set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/defaultscrollbar/@thumb_color_active">[kuAccent]</set>
	<set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/defaultscrollbar/@thumb_color_inactive">[kuTextMuted]</set>
	<set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/defaultscrollbar/@border_color_active">[transparent]</set>
	<set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/defaultscrollbar/@border_color_inactive">[transparent]</set>
	<set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/defaultscrollbar/@background_color_active">[kuTrack]</set>
	<set xpath="/windows/window[@name='windowLooting']/rect[@name='content']/defaultscrollbar/@background_color_inactive">[kuTrack]</set>

	<!-- ================================================================ -->
	<!-- Crafting list, recipe info, item info, empty "Inspect" panel     -->
	<!-- Vanilla builds these from opaque grey blocks boxed in black 3px  -->
	<!-- frames, with no window background. Generic pass first, then the  -->
	<!-- pieces that need something else.                                 -->
	<!-- ================================================================ -->

	<!-- Black 3px frames go. -->
	<set xpath="/windows/window[@name='windowCraftingList' or @name='craftingInfoPanel' or @name='emptyInfoPanel' or @name='itemInfoPanel']//sprite[@sprite='menu_empty3px' and @color='[black]']/@color">[transparent]</set>
	<!-- Plain grey blocks become soft rounded cells (darkestGrey: the alternate stat rows). -->
	<setattribute xpath="/windows/window[@name='windowCraftingList' or @name='craftingInfoPanel' or @name='emptyInfoPanel' or @name='itemInfoPanel']//sprite[not(@sprite)][not(@name)][@color='[darkGrey]' or @color='[mediumGrey]' or @color='[lightGrey]' or @color='[darkestGrey]']" name="sprite">ku_round_sm</setattribute>
	<set xpath="/windows/window[@name='windowCraftingList' or @name='craftingInfoPanel' or @name='emptyInfoPanel' or @name='itemInfoPanel']//sprite[@sprite='ku_round_sm'][@color='[darkGrey]' or @color='[mediumGrey]' or @color='[lightGrey]']/@color">[kuCell]</set>
	<set xpath="/windows/window[@name='windowCraftingList' or @name='craftingInfoPanel' or @name='emptyInfoPanel' or @name='itemInfoPanel']//sprite[@sprite='ku_round_sm'][@color='[darkestGrey]']/@color">[kuCellAlt]</set>

	<!-- Glass bodies under the glass headers (depth -1: below everything in the content). -->
	<prepend xpath="/windows/window[@name='windowCraftingList']/rect[@name='content']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,3" width="397" height="656" />
	</prepend>
	<prepend xpath="/windows/window[@name='craftingInfoPanel']/rect[@name='contentCraftingInfo']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,3" width="603" height="351" />
	</prepend>
	<prepend xpath="/windows/window[@name='itemInfoPanel']/rect[@name='contentInfo']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,3" width="603" height="350" />
	</prepend>
	<!-- The empty Inspect panel already has one full-size fill: make that the body. -->
	<set xpath="/windows/window[@name='emptyInfoPanel']/rect[@name='contentCraftingInfo']/sprite[@sprite='ku_round_sm']/@sprite">ku_panel_body</set>
	<set xpath="/windows/window[@name='emptyInfoPanel']/rect[@name='contentCraftingInfo']/sprite[@sprite='ku_panel_body']/@color">[white]</set>
	<setattribute xpath="/windows/window[@name='emptyInfoPanel']/rect[@name='contentCraftingInfo']/sprite[@sprite='ku_panel_body']" name="pos">0,3</setattribute>

	<!-- Item preview: a dark well like a slot. -->
	<set xpath="/windows/window[@name='craftingInfoPanel' or @name='itemInfoPanel']//rect[@name='preview']/sprite[@sprite='ku_round_sm']/@sprite">ku_round_md</set>
	<set xpath="/windows/window[@name='craftingInfoPanel' or @name='itemInfoPanel']//rect[@name='preview']/sprite[@sprite='ku_round_md']/@color">[kuSlotWell]</set>

	<!-- Durability: thin rounded bars. -->
	<setattribute xpath="/windows/window[@name='craftingInfoPanel' or @name='itemInfoPanel']//*[@name='durabilityBackground' or @name='removedurabilityBar' or @name='durabilityBar']" name="sprite">ku_bar</setattribute>
	<set xpath="/windows/window[@name='craftingInfoPanel']//sprite[@name='durabilityBackground']/@color">[kuTrack]</set>
	<set xpath="/windows/window[@name='itemInfoPanel']//sprite[@name='durabilityBackground']/@color">255,107,90,150</set>
	<set xpath="/windows/window[@name='itemInfoPanel']//filledsprite[@name='removedurabilityBar']/@color">[kuTrack]</set>

	<!-- Labels and icons that used vanilla red/beige/white. -->
	<set xpath="/windows/window[@name='craftingInfoPanel']//sprite[@name='requiredToolCheckmark']/@color">[kuDanger]</set>
	<set xpath="/windows/window[@name='craftingInfoPanel']//label[@name='craftingTime']/@color">[kuGold]</set>
	<set xpath="/windows/window[@name='itemInfoPanel']/rect[@name='header']/sprite[@name='costIcon']/@color">[kuGold]</set>
	<setattribute xpath="/windows/window[@name='windowCraftingList' or @name='craftingInfoPanel' or @name='emptyInfoPanel' or @name='itemInfoPanel']/rect[@name='header']/label" name="color">[kuGold]</setattribute>
	<setattribute xpath="/windows/window[@name='windowCraftingList' or @name='craftingInfoPanel' or @name='emptyInfoPanel' or @name='itemInfoPanel']/rect[@name='header']/sprite[@name='windowIcon']" name="color">[kuAccent]</setattribute>

	<!-- ================================================================ -->
	<!-- Workstation side panels (forge, campfire, workbench, collectors) -->
	<!-- Tools / Fuel / Smelting / Output / Combine: glass headers come   -->
	<!-- from headerbg already; vanilla gives them no body at all.        -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowToolsForge' or @name='windowToolsCampfire' or @name='windowDewCollectorMods' or @name='windowFuel' or @name='windowForgeInput' or @name='windowOutput' or @name='windowCombine' or @name='windowCollectorFuel' or @name='windowCollectorCatalyst']//sprite[@sprite='menu_empty3px' and @color='[black]']/@color">[transparent]</set>
	<setattribute xpath="/windows/window[@name='windowForgeInput' or @name='windowCombine']//sprite[not(@sprite)][@color='[darkGrey]' or @color='[mediumGrey]' or @color='[lightGrey]']" name="sprite">ku_round_sm</setattribute>
	<set xpath="/windows/window[@name='windowForgeInput' or @name='windowCombine']//sprite[@sprite='ku_round_sm'][@color='[darkGrey]' or @color='[mediumGrey]' or @color='[lightGrey]']/@color">[kuCell]</set>

	<!-- Bodies: from just under the 43px header to the bottom of the slots / button. -->
	<prepend xpath="/windows/window[@name='windowToolsForge' or @name='windowToolsCampfire' or @name='windowDewCollectorMods']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="228" height="85" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowFuel']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="228" height="124" />
	</prepend>
	<!-- Smelting input and Output are sized by their grids, which other mods resize -->
	<!-- (KitsuneMoreSloots: input 2 -> 3 rows, output 2x3 -> 3x3). Anchor the body to -->
	<!-- the grid instead of fixed numbers, the way vanilla's dew collector does: 6px -->
	<!-- above the grid (meeting the header), 3px past it on the other sides.          -->
	<setattribute xpath="/windows/window[@name='windowForgeInput']/rect[@name='content']/grid" name="name">kuInputGrid</setattribute>
	<prepend xpath="/windows/window[@name='windowForgeInput']/rect[@name='content']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]"
			anchor_left="kuInputGrid,0,-3" anchor_right="kuInputGrid,1,150" anchor_top="kuInputGrid,1,6" anchor_bottom="kuInputGrid,0,-3" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowOutput']/rect[@name='content']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]"
			anchor_left="inventory,0,-3" anchor_right="inventory,1,0" anchor_top="inventory,1,6" anchor_bottom="inventory,0,-3" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowCollectorFuel']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="228" height="238" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowCollectorCatalyst']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="228" height="{# fuel_row_count * 75 + 9 }" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowCombine']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="610" height="429" />
	</prepend>

	<!-- Turn On / Turn Off: a glass button like the rest. -->
	<set xpath="/windows/window[@name='windowFuel']//button[@name='button']/@sprite">ku_round_md</set>
	<set xpath="/windows/window[@name='windowFuel']//button[@name='button']/@hoversprite">ku_round_md</set>
	<set xpath="/windows/window[@name='windowFuel']//button[@name='button']/@defaultcolor">[kuBtn]</set>
	<set xpath="/windows/window[@name='windowFuel']//button[@name='button']/@disabledcolor">[kuBtnDisabled]</set>
	<set xpath="/windows/window[@name='windowFuel']//button[@name='button']/@hovercolor">[kuBtnHover]</set>

	<!-- Smelting reserves: materials the forge accepts in green, others in red. -->
	<set xpath="/windows/window[@name='windowForgeInput']/@valid_materials_color">[kuGood]</set>
	<set xpath="/windows/window[@name='windowForgeInput']/@invalid_materials_color">[kuDanger]</set>

	<!-- Dew collector: its own raw header sprite (tinted grey) and a near-invisible bg. -->
	<set xpath="/windows/window[@name='windowDewCollector']/rect[@name='header']/sprite[@name='sprBackground']/@color">[white]</set>
	<set xpath="/windows/window[@name='windowDewCollector']/rect[@name='content']/sprite[@name='bg']/@sprite">ku_panel_body</set>
	<set xpath="/windows/window[@name='windowDewCollector']/rect[@name='content']/sprite[@name='bg']/@color">[white]</set>
	<set xpath="/windows/window[@name='windowDewCollector']/rect[@name='content']/sprite[@name='bg']/@anchor_top">queue,1,6</set>

	<!-- ================================================================ -->
	<!-- Crafting queue                                                   -->
	<!-- Vanilla has no background (it's commented out), so the cells    -->
	<!-- float over the world. A glass tray anchored to the queue grid,   -->
	<!-- so it fits vanilla's 4x1 or a mod's 2x5 (KitsuneMoreSloots).     -->
	<!-- Cells are 72px on a 75px pitch, hence the uneven right/bottom.   -->
	<!-- ================================================================ -->
	<prepend xpath="/windows/window[@name='windowCraftingQueue']/rect[@controller='CraftingQueue']">
		<sprite depth="-1" name="kuTray" sprite="ku_panel" type="sliced" color="[white]"
			anchor_left="queue,0,-9" anchor_right="queue,1,6" anchor_top="queue,1,9" anchor_bottom="queue,0,-6" />
	</prepend>

	<!-- ================================================================ -->
	<!-- Cosmetics (character preview + cosmetics list)                   -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='CharacterCosmeticWindow' or @name='windowCharacterCosmeticsList']//sprite[@sprite='menu_empty3px' and @color='[black]']/@color">[transparent]</set>
	<!-- The flat navy behind the character becomes the glass body. -->
	<setattribute xpath="/windows/window[@name='CharacterCosmeticWindow']//rect[@name='previewFrameSDCS']//sprite[not(@sprite)][@color='[darkGrey]']" name="sprite">ku_panel_body</setattribute>
	<set xpath="/windows/window[@name='CharacterCosmeticWindow']//rect[@name='previewFrameSDCS']//sprite[@sprite='ku_panel_body']/@color">[white]</set>
	<setattribute xpath="/windows/window[@name='CharacterCosmeticWindow']//rect[@name='previewFrameSDCS']//sprite[@sprite='ku_panel_body']" name="pos">0,3</setattribute>
	<!-- Category bar as a soft cell; a glass body behind the list (vanilla has none). -->
	<setattribute xpath="/windows/window[@name='windowCharacterCosmeticsList']/rect[@name='categoryHeader']/sprite[@name='background']" name="sprite">ku_round_sm</setattribute>
	<set xpath="/windows/window[@name='windowCharacterCosmeticsList']/rect[@name='categoryHeader']/sprite[@name='background']/@color">[kuCell]</set>
	<prepend xpath="/windows/window[@name='windowCharacterCosmeticsList']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="606" height="652" />
	</prepend>
	<setattribute xpath="/windows/window[@name='CharacterCosmeticWindow']/rect[@name='header']/label[@name='characterName']" name="color">[kuGold]</setattribute>
	<setattribute xpath="/windows/window[@name='CharacterCosmeticWindow' or @name='windowCharacterCosmeticsList']/rect[@name='header']/sprite[@name='windowIcon']" name="color">[kuAccent]</setattribute>
	<setattribute xpath="/windows/window[@name='windowCharacterCosmeticsList']/rect[@name='header']/label[@name='windowName']" name="color">[kuGold]</setattribute>

	<!-- ================================================================ -->
	<!-- Trader and quest windows                                         -->
	<!-- Generic pass (frames out, grey blocks to soft cells), then the   -->
	<!-- full-size fills become glass bodies and the rest gets bodies.    -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowTrader' or @name='serviceInfoPanel' or @name='windowQuestOffer' or @name='windowQuestTurnInDescription' or @name='windowQuestTurnInRewards' or @name='windowQuestList' or @name='windowQuestSharedList' or @name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards']//sprite[@sprite='menu_empty3px' and @color='[black]']/@color">[transparent]</set>
	<setattribute xpath="/windows/window[@name='windowTrader' or @name='serviceInfoPanel' or @name='windowQuestTurnInDescription' or @name='windowQuestTurnInRewards' or @name='windowQuestList' or @name='windowQuestSharedList' or @name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards']//sprite[not(@sprite)][@color='[darkGrey]' or @color='[mediumGrey]' or @color='[lightGrey]' or @color='[darkestGrey]']" name="sprite">ku_round_sm</setattribute>
	<set xpath="/windows/window[@name='windowTrader' or @name='serviceInfoPanel' or @name='windowQuestTurnInDescription' or @name='windowQuestTurnInRewards' or @name='windowQuestList' or @name='windowQuestSharedList' or @name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards']//sprite[@sprite='ku_round_sm'][@color='[darkGrey]' or @color='[mediumGrey]' or @color='[darkestGrey]']/@color">[kuCell]</set>
	<set xpath="/windows/window[@name='windowTrader' or @name='windowQuestTurnInRewards']//sprite[@sprite='ku_round_sm'][@color='[lightGrey]']/@color">[kuCellHeader]</set>

	<!-- Single-panel quest windows: their one full-size fill becomes the glass body. -->
	<set xpath="/windows/window[@name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards' or @name='windowQuestTurnInDescription']/rect[@name='content']/sprite[@sprite='ku_round_sm']/@sprite">ku_panel_body</set>
	<set xpath="/windows/window[@name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards' or @name='windowQuestTurnInDescription']/rect[@name='content']/sprite[@sprite='ku_panel_body']/@color">[white]</set>
	<setattribute xpath="/windows/window[@name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards' or @name='windowQuestTurnInDescription']/rect[@name='content']/sprite[@sprite='ku_panel_body']" name="pos">0,3</setattribute>

	<!-- Windows whose content is several blocks: one glass body behind the lot. -->
	<prepend xpath="/windows/window[@name='windowTrader']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="645" height="653" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowQuestTurnInRewards']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="653" height="427" />
	</prepend>
	<prepend xpath="/windows/window[@name='windowQuestList']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="453" height="{# questsautoaccept ? 698 : 468 }" />
	</prepend>
	<prepend xpath="/windows/window[@name='serviceInfoPanel']/rect[@name='contentInfo']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,3" width="603" height="349" />
	</prepend>
	<set xpath="/windows/window[@name='serviceInfoPanel']//rect[@name='preview']/sprite[@sprite='ku_round_sm']/@color">[kuSlotWell]</set>

	<!-- Job offer: glass body, and Accept / Decline as green / red glass buttons. -->
	<setattribute xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/boxbg" name="backsprite">ku_panel_body</setattribute>
	<setattribute xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/boxbg" name="backcolor">[white]</setattribute>
	<setattribute xpath="/windows/window[@name='windowQuestOffer']/rect[@name='content']/boxbg" name="bordercolor">[transparent]</setattribute>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept' or @name='btnDecline']/sprite[@name='background']/@color">[transparent]</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept' or @name='btnDecline']//button[@name='clickable']/@sprite">ku_round_md</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept' or @name='btnDecline']//button[@name='clickable']/@hoversprite">ku_round_md</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept']//button[@name='clickable']/@defaultcolor">[kuBtnGood]</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnAccept']//button[@name='clickable']/@hovercolor">[kuBtnGoodHover]</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnDecline']//button[@name='clickable']/@defaultcolor">[kuBtnBad]</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='btnDecline']//button[@name='clickable']/@hovercolor">[kuBtnBadHover]</set>
	<set xpath="/windows/window[@name='windowQuestOffer']/rect[@name='header']/sprite[@sprite='ui_game_symbol_quest_limited']/@color">[kuDanger]</set>

	<!-- Gold titles on the windows that set their own header label. -->
	<setattribute xpath="/windows/window[@name='windowTrader' or @name='serviceInfoPanel' or @name='windowQuestTurnInDescription' or @name='windowQuestTurnInRewards' or @name='windowQuestList' or @name='windowQuestSharedList' or @name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards']/rect[@name='header']/label[not(@style)][not(@color)]" name="color">[kuGold]</setattribute>
	<setattribute xpath="/windows/window[@name='windowTrader' or @name='serviceInfoPanel' or @name='windowQuestTurnInDescription' or @name='windowQuestTurnInRewards' or @name='windowQuestList' or @name='windowQuestSharedList' or @name='windowQuestDescription' or @name='windowQuestObjectives' or @name='windowQuestRewards']/rect[@name='header']/sprite[@name='windowIcon'][not(@color)]" name="color">[kuAccent]</setattribute>

	<!-- ================================================================ -->
	<!-- Dialog (trader / NPC responses)                                  -->
	<!-- Vanilla: a wide text-body box. Ours: a narrower glass panel on   -->
	<!-- the right with a glass header (name in gold, talk icon), so more -->
	<!-- of the trader stays visible.                                     -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowResponses']/@pos">-680,40</set>
	<set xpath="/windows/window[@name='windowResponses']/@width">640</set>
	<set xpath="/windows/window[@name='windowResponses']/sprite[@name='background']/@sprite">ku_panel_body</set>
	<setattribute xpath="/windows/window[@name='windowResponses']/sprite[@name='background']" name="type">sliced</setattribute>
	<setattribute xpath="/windows/window[@name='windowResponses']/sprite[@name='background']" name="pos">0,-40</setattribute>
	<setattribute xpath="/windows/window[@name='windowResponses']/sprite[@name='background']" name="width">640</setattribute>
	<setattribute xpath="/windows/window[@name='windowResponses']/sprite[@name='background']" name="height">420</setattribute>
	<prepend xpath="/windows/window[@name='windowResponses']">
		<sprite depth="1" name="kuHeader" sprite="ui_game_panel_header" type="sliced" pos="0,0" width="640" height="43" />
		<sprite depth="3" name="kuIcon" sprite="ui_game_symbol_talk" pos="8,-6" width="30" height="30" color="[kuAccent]" />
	</prepend>
	<set xpath="/windows/window[@name='windowResponses']/label[@name='lblName']/@color">[kuGold]</set>
	<set xpath="/windows/window[@name='windowResponses']/label[@name='lblName']/@pos">46,-6</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@width">634</set>
	<set xpath="/windows/window[@name='windowResponses']/grid[@name='items']/@cell_width">634</set>

	<!-- ================================================================ -->
	<!-- Subtitles (NPC speech, e.g. a trader's greeting)                 -->
	<!-- Vanilla sits at 155 from the bottom, just above a one-row        -->
	<!-- toolbelt; our tray with two bars (KitsuneUI_Toolbelt20) reaches  -->
	<!-- ~175, so the subtitle landed on the top row. 245 clears both.    -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='subtitlesDisplay'][@pos='-376,155']/@pos">-376,245</set>
	<setattribute xpath="/windows/window[@name='subtitlesDisplay']//label[@name='lblSpeaker']" name="color">[kuGold]</setattribute>

	<!-- On-screen popups ("The Duke left you a note..."): the game already lifts them 75px -->
	<!-- when the toolbelt has a second bar, which puts them right on the tray's top edge.  -->
	<!-- 10px more clears the tray with one bar or two.                                      -->
	<set xpath="/windows/window[@name='toolTipPopups'][@pos='0,100']/@pos">0,110</set>

	<!-- ================================================================ -->
	<!-- Creative menu (windowCreative2)                                  -->
	<!-- Vanilla: grey category columns and search bar boxed in black,    -->
	<!-- and no background at all behind the item grid.                   -->
	<!-- ================================================================ -->
	<prepend xpath="/windows/window[@name='windowCreative2']/rect[@name='content']">
		<sprite depth="-1" name="kuBody" sprite="ku_panel_body" type="sliced" color="[white]" pos="0,-40" width="629" height="738" />
	</prepend>
	<set xpath="/windows/window[@name='windowCreative2']//sprite[@sprite='menu_empty3px' and @color='[black]']/@color">[transparent]</set>
	<setattribute xpath="/windows/window[@name='windowCreative2']//rect[@name='searchControls' or @name='categoryBar' or @name='categoryBar2']/sprite[@name='background']" name="sprite">ku_round_sm</setattribute>
	<set xpath="/windows/window[@name='windowCreative2']//rect[@name='searchControls' or @name='categoryBar' or @name='categoryBar2']/sprite[@name='background']/@color">[kuCell]</set>
	<!-- Separators between category groups: black bars -> soft gold. -->
	<set xpath="/windows/window[@name='windowCreative2']//sprite[@sprite='ui_game_symbol_subtract']/@color">[kuGoldSoft]</set>
	<setattribute xpath="/windows/window[@name='windowCreative2']/rect[@name='content']/rect[@name='header']/label[@style='header.name']" name="color">[kuGold]</setattribute>
	<setattribute xpath="/windows/window[@name='windowCreative2']/rect[@name='content']/rect[@name='header']/label[not(@style)]" name="color">[kuTextMid]</setattribute>
	<setattribute xpath="/windows/window[@name='windowCreative2']/rect[@name='content']/rect[@name='header']/sprite[@name='windowicon']" name="color">[kuAccent]</setattribute>

	<!-- ================================================================ -->
	<!-- HUD: player stat bars (health, stamina, food, water)             -->
	<!-- Vanilla layers per bar, kept by name:                            -->
	<!--   border (d1, d8) + black filledsprite outlines -> gone          -->
	<!--   background d2 (full width)          -> injury hatch pill       -->
	<!--   background d3 (fill statmodifiedmax) -> dark track pill        -->
	<!--   BarContent d5 (fill statfill)        -> colour pill            -->
	<!-- The track covers the hatch up to the injury-reduced max, so the  -->
	<!-- stripes only show on the part an injury has cut off.             -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@controller='HUDStatBar']/sprite[@name='border']/@color">[transparent]</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@controller='HUDStatBar']/filledsprite[@name='background']/@color">[transparent]</set>

	<setattribute xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina']/sprite[@name='background' and @depth='2']" name="sprite">ku_hudhatch_lg</setattribute>
	<setattribute xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water']/sprite[@name='background' and @depth='2']" name="sprite">ku_hudhatch_sm</setattribute>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Food' or @stat_type='Water']/sprite[@name='background' and @depth='2']/@type">simple</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Food' or @stat_type='Water']/sprite[@name='background' and @depth='2']/@color">[kuHatch]</set>

	<setattribute xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Stealth']/sprite[(@name='background' and @depth='3') or @name='BarContent']" name="sprite">ku_hudbar_lg</setattribute>
	<setattribute xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water']/sprite[(@name='background' and @depth='3') or @name='BarContent']" name="sprite">ku_hudbar_sm</setattribute>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@controller='HUDStatBar']/sprite[@name='background' and @depth='3']/@color">[kuHudTrack]</set>

	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health']/sprite[@name='BarContent']/@color">[kuHealth]</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Stamina']/sprite[@name='BarContent']/@color">[kuStamina]</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food']/sprite[@name='BarContent']/@color">[kuFood]</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water']/sprite[@name='BarContent']/@color">[kuWater]</set>

	<!-- Wider than vanilla (~18%): bars 171 -> 201, food/water 83 -> 97 each with water  -->
	<!-- moved to keep the gap, labels widened to match. Left edge stays put. Values are -->
	<!-- matched exactly so a mod that already resized a bar is left alone.              -->
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud' and @width='168']/@width">198</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Stealth'][@width='171']/@width">201</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Stealth']/*[@width='171']/@width">201</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Stealth']/*[@width='170']/@width">200</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Stealth']/*[@width='169']/@width">199</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Health' or @stat_type='Stamina' or @stat_type='Stealth']/label[@width='125']/@width">155</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Stamina']/sprite[@name='sprint']/@pos">200,-23</set>

	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water'][@width='83']/@width">97</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water']/*[@width='84']/@width">98</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water']/*[@width='83']/@width">97</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water']/*[@width='82']/@width">96</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Food' or @stat_type='Water']/label[@width='45']/@width">59</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Water'][@pos='87,-120']/@pos">104,-120</set>

	<!-- Buff pop-outs above the bars, widened to match (168 -> 198, left edge kept). -->
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/@width">198</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/@pos">85, 0</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/sprite[@name='Background']/@width">192</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/filledsprite[@name='BarContent']/@pos">-95,0</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/filledsprite[@name='BarContent']/@size">190,40</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/sprite[@name='Icon']/@pos">-69,0</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/label[@name='TextContent']/@pos">-52,0</set>
	<set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@controller='BuffPopoutList']/rect[@name='item']/label[@name='TextContent']/@size">148,40</set>
	<!-- The pop-up chip (ui_game_popup, ours) is 9-sliced so it takes any width cleanly. -->
	<setattribute xpath="/windows/window[@name='HUDLeftStatBars' or @name='HUDRightStatBars']//sprite[@sprite='ui_game_popup']" name="type">sliced</setattribute>

	<!-- Stealth (only while crouched): no hatch, the colour comes from code. -->
	<set xpath="/windows/window[@name='HUDLeftStatBars']//rect[@stat_type='Stealth']/sprite[@name='background' and @depth='2']/@color">[transparent]</set>

	<!-- Text on the brighter fills: a dark outline keeps it readable. -->
	<setattribute xpath="/windows/window[@name='HUDLeftStatBars' or @name='HUDRightStatBars' or @name='windowTargetBar']//label[@name='TextContent']" name="effect">outline</setattribute>
	<setattribute xpath="/windows/window[@name='HUDLeftStatBars' or @name='HUDRightStatBars' or @name='windowTargetBar']//label[@name='TextContent']" name="effect_color">0,0,0,200</setattribute>

	<!-- ================================================================ -->
	<!-- HUD: vehicle fuel and health (bottom right while driving)        -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleFuel' or @stat_type='VehicleHealth']/sprite[@name='border']/@color">[transparent]</set>
	<set xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleFuel' or @stat_type='VehicleHealth']/sprite[@name='background'][@pos]/@color">[transparent]</set>
	<set xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleFuel' or @stat_type='VehicleHealth']/sprite[@name='background'][not(@pos)]/@color">[kuHudTrack]</set>
	<setattribute xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleFuel' or @stat_type='VehicleHealth']/sprite[@name='background'][not(@pos)]" name="sprite">ku_round_md</setattribute>
	<setattribute xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleFuel' or @stat_type='VehicleHealth']/sprite[@name='BarContent']" name="sprite">ku_hudbar_lg</setattribute>
	<set xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleFuel']/sprite[@name='BarContent']/@color">[kuStamina]</set>
	<set xpath="/windows/window[@name='HUDRightStatBars']//rect[@stat_type='VehicleHealth']/sprite[@name='BarContent']/@color">[kuHealth]</set>

	<!-- ================================================================ -->
	<!-- HUD: enemy health bar                                            -->
	<!-- Vanilla shows it in god mode only (visibility never / godmode /  -->
	<!-- always). KitsuneUI shows it always: Ada's call, 2026-10-13.      -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowTargetBar']/@visibility">always</set>
	<setattribute xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border' or @name='BarContent']" name="sprite">ku_hudbar_xl</setattribute>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']/@type">simple</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='border']/@color">[kuHudTrack]</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[@visible='{isnotboss}']/sprite[@name='BarContent']/@color">[kuHealth]</set>

	<!-- ================================================================ -->
	<!-- HUD: location box (place name + difficulty skulls, top right)    -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowLocation']/sprite[@name='Background']/@sprite">ku_panel_sm</set>
	<set xpath="/windows/window[@name='windowLocation']/sprite[@name='Background']/@color">[white]</set>
	<set xpath="/windows/window[@name='windowLocation']/sprite[@name='backgroundMain']/@color">[transparent]</set>
	<setattribute xpath="/windows/window[@name='windowLocation']/label" name="color">[kuGold]</setattribute>
	<!-- Chonkier (box 250x46 -> 262x56, name 20 -> 24) and 12px lower, clear of the version -->
	<!-- label above it. The right edge stays put (-259+250 = -271+262 = -9).                  -->
	<set xpath="/windows/window[@name='windowLocation']/@pos">-271, -52</set>
	<set xpath="/windows/window[@name='windowLocation']/@width">262</set>
	<set xpath="/windows/window[@name='windowLocation']/sprite[@name='Background' or @name='backgroundMain']/@width">262</set>
	<set xpath="/windows/window[@name='windowLocation']/sprite[@name='Background' or @name='backgroundMain']/@height">56</set>
	<set xpath="/windows/window[@name='windowLocation']/label/@font_size">24</set>
	<set xpath="/windows/window[@name='windowLocation']/label/@pos">6,0</set>
	<set xpath="/windows/window[@name='windowLocation']/label/@height">30</set>
	<set xpath="/windows/window[@name='windowLocation']/grid/@pos">131, -34</set>

	<!-- ================================================================ -->
	<!-- HUD: quest / challenge tracker and recipe tracker (top right)    -->
	<!-- Vanilla stretches the pop-up chip behind them. The text is right -->
	<!-- aligned, so they sit on fading glass: solid on the right, gone   -->
	<!-- on the left.                                                     -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowQuestTracker' or @name='windowRecipeTracker']/sprite[@name='Background']/@sprite">ku_fade_r</set>
	<setattribute xpath="/windows/window[@name='windowQuestTracker' or @name='windowRecipeTracker']/sprite[@name='Background']" name="color">[kuHudFade]</setattribute>
	<setattribute xpath="/windows/window[@name='windowQuestTracker' or @name='windowRecipeTracker']/label[@text='{questtitle}' or @text='{recipetitle}']" name="color">[kuGold]</setattribute>
	<set xpath="/windows/window[@name='windowQuestTracker' or @name='windowRecipeTracker']/grid/@complete_color">[kuGood]</set>
	<!-- Moved down 22px to stay clear of the bigger, lower location box above them. -->
	<set xpath="/windows/window[@name='windowQuestTracker' or @name='windowRecipeTracker'][@pos='-255, -88']/@pos">-255, -110</set>

	<!-- ================================================================ -->
	<!-- HUD: compass                                                     -->
	<!-- Two grey header-fill boxes -> one glass strip, plus a fox-fire   -->
	<!-- tick at the centre where you're facing.                          -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='windowCompass']/sprite[@sprite='ui_game_header_fill' and @depth='0']/@color">[white]</set>
	<set xpath="/windows/window[@name='windowCompass']/sprite[@sprite='ui_game_header_fill' and @depth='0']/@sprite">ku_panel_sm</set>
	<set xpath="/windows/window[@name='windowCompass']/sprite[@sprite='ui_game_header_fill' and @depth='1']/@color">[transparent]</set>
	<append xpath="/windows/window[@name='windowCompass']">
		<sprite depth="9" name="kuNeedle" sprite="ku_pill" pos="238,-2" width="4" height="12" color="[kuAccent]" visible="{show_compass}" />
	</append>

	<!-- ================================================================ -->
	<!-- HUD: block health under the crosshair                            -->
	<!-- ================================================================ -->
	<set xpath="/windows/window[@name='focusedBlockHealth']/sprite[@name='background']/@sprite">ku_bar</set>
	<set xpath="/windows/window[@name='focusedBlockHealth']/sprite[@name='background']/@color">[kuHudTrack]</set>
	<setattribute xpath="/windows/window[@name='focusedBlockHealth']/sprite[@name='bar']" name="sprite">ku_hudbar_thin</setattribute>
	<set xpath="/windows/window[@name='focusedBlockHealth']/sprite[@name='bar']/@color">[kuIcon]</set>

	<!-- ================================================================ -->
	<!-- Toolbelt                                                         -->
	<!-- ================================================================ -->

	<!-- A glass tray that grows with the number of bars (1, or 2 with KitsuneUI_Toolbelt20). -->
	<!-- Bars stack upward 82px apart, so the tray's top follows beltCount; it sits inside  -->
	<!-- the Toolbelt controller, which is what provides beltCount.                         -->
	<set xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@name='backgroundMain']/@color">[transparent]</set>
	<prepend xpath="/windows/window[@name='windowToolbelt']/rect/rect[@controller='Toolbelt']">
		<sprite depth="0" name="kuTray" sprite="ku_panel" type="sliced" color="[white]"
			pos="{%'-9, ' + ((beltCount - 1) * 82 + 9)}" width="768" height="{%beltCount * 82 + 11}" />
	</prepend>

	<!-- XP bar: vanilla sits on the toolbelt's top edge, which with two bars is between them. -->
	<!-- Move it under the tray as a thin rounded bar in the XP colour.                       -->
	<set xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@visible='{showxp}']/@pos">3,-92</set>
	<set xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@visible='{showxp}']/@height">5</set>
	<set xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@visible='{showxp}']/@sprite">ku_bar</set>
	<setattribute xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@visible='{showxp}' and @depth='1']" name="width">750</setattribute>
	<set xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@visible='{showxp}' and @depth='1']/@color">[kuTrack]</set>
	<set xpath="/windows/window[@name='windowToolbelt']/rect/sprite[@visible='{showxp}' and @depth='9']/@color">[transparent]</set>
	<setattribute xpath="/windows/window[@name='windowToolbelt']" name="standard_xp_color">180,140,255,255</setattribute>
	<setattribute xpath="/windows/window[@name='windowToolbelt']" name="updating_xp_color">212,186,255,255</setattribute>
	<setattribute xpath="/windows/window[@name='windowToolbelt']" name="deficit_xp_color">255,107,90,255</setattribute>

</configs>
