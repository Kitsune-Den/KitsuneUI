<configs>

	<!-- ================================================================ -->
	<!-- Item slot (every backpack, loot, toolbelt and storage cell)      -->
	<!-- Vanilla layers, kept by name so other mods' patches still land:  -->
	<!--   backgroundMain   black 3px frame  -> faint rounded edge        -->
	<!--   background       {selectionbordercolor} frame -> rounded ring  -->
	<!--   highlightOverlay {backgroundcolor} fill -> rounded fill        -->
	<!-- The ring colour comes from the itemStack style: select_color     -->
	<!-- when selected, highlight_color on hover, holding_color for the   -->
	<!-- held toolbelt slot, background_color otherwise.                  -->
	<!-- ================================================================ -->

	<set xpath="/templates/item_stack/rect/sprite[@name='backgroundMain']/@sprite">ku_slot_ring</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='backgroundMain']/@color">[kuEdge]</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='backgroundMain']/@pos">1,-1</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='backgroundMain']/@width">${-2+cell_size}</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='backgroundMain']/@height">${-2+cell_size}</set>

	<set xpath="/templates/item_stack/rect/sprite[@name='background']/@sprite">ku_slot_ring2</set>
	<setattribute xpath="/templates/item_stack/rect/sprite[@name='background']" name="pos">1,-1</setattribute>

	<setattribute xpath="/templates/item_stack/rect/sprite[@name='highlightOverlay']" name="sprite">ku_slot_fill</setattribute>
	<setattribute xpath="/templates/item_stack/rect/sprite[@name='highlightOverlay']" name="pos">1,-1</setattribute>
	<set xpath="/templates/item_stack/rect/sprite[@name='highlightOverlay']/@width">${-2+cell_size}</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='highlightOverlay']/@height">${-2+cell_size}</set>

	<!-- Fox-fire glow behind the slot, in the ring's colour: nearly invisible for a plain -->
	<!-- slot (background_color is 5% white), cyan when selected or held, gold on hover.   -->
	<insertBefore xpath="/templates/item_stack/rect/sprite[@name='backgroundMain']">
		<sprite depth="1" name="kuGlow" sprite="ku_glow" type="sliced" color="{selectionbordercolor}"
			pos="-7,7" width="${14+cell_size}" height="${14+cell_size}" />
	</insertBefore>

	<!-- Durability: a thin rounded bar inset from the slot edge instead of a 10px block. -->
	<set xpath="/templates/item_stack/rect/sprite[@name='durabilityBackground']/@sprite">ku_bar</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='durabilityBackground']/@color">255,107,90,150</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='durability']/@sprite">ku_bar</set>
	<set xpath="/templates/item_stack/rect/sprite[@name='durability']/@color">[kuTrack]</set>
	<set xpath="/templates/item_stack/rect/filledsprite[@name='durability']/@sprite">ku_bar</set>
	<set xpath="/templates/item_stack/rect/*[@name='durabilityBackground' or @name='durability']/@pos">6,${-Floor(4*cell_size/5)-3}</set>
	<set xpath="/templates/item_stack/rect/*[@name='durabilityBackground' or @name='durability']/@width">${-12+cell_size}</set>
	<set xpath="/templates/item_stack/rect/*[@name='durabilityBackground' or @name='durability']/@height">5</set>

	<!-- ================================================================ -->
	<!-- Cosmetic and material slots: the same three layers as item_stack -->
	<!-- (frame / selection ring / fill), at fixed sizes. Same treatment. -->
	<!-- ================================================================ -->
	<set xpath="/templates/*[self::cosmetic_item_stack or self::material_stack]/rect/sprite[@name='backgroundMain']/@sprite">ku_slot_ring</set>
	<set xpath="/templates/*[self::cosmetic_item_stack or self::material_stack]/rect/sprite[@name='backgroundMain']/@color">[kuEdge]</set>
	<set xpath="/templates/*[self::cosmetic_item_stack or self::material_stack]/rect/sprite[@name='backgroundMain']/@pos">0,0</set>
	<set xpath="/templates/cosmetic_item_stack/rect/sprite[@name='backgroundMain']/@width">65</set>
	<set xpath="/templates/cosmetic_item_stack/rect/sprite[@name='backgroundMain']/@height">65</set>
	<set xpath="/templates/material_stack/rect/sprite[@name='backgroundMain']/@width">73</set>
	<set xpath="/templates/material_stack/rect/sprite[@name='backgroundMain']/@height">73</set>
	<set xpath="/templates/*[self::cosmetic_item_stack or self::material_stack]/rect/sprite[@name='background']/@sprite">ku_slot_ring2</set>
	<setattribute xpath="/templates/*[self::cosmetic_item_stack or self::material_stack]/rect/sprite[@name='highlightOverlay']" name="sprite">ku_slot_fill</setattribute>
	<set xpath="/templates/material_stack/rect/sprite[@name='highlightOverlay']/@color">[kuSlotWell]</set>

	<!-- Owned vs locked cosmetics. The game tells them apart only by the slot fill:     -->
	<!-- locked = a fixed 48 grey (not settable: the locked_background_color attribute -->
	<!-- writes the OWNED colour, a game bug), owned = background_color, which for     -->
	<!-- every other slot is our dark well, so the two were nearly the same. Owned gets -->
	<!-- a fox-fire teal well, and locked ones get a dark veil over the icon.          -->
	<setattribute xpath="/templates/cosmetic_item_stack/rect" name="background_color">[kuCosmeticOwned]</setattribute>
	<append xpath="/templates/cosmetic_item_stack/rect">
		<sprite depth="7" name="kuLockedVeil" sprite="ku_slot_fill" width="65" height="65" color="[kuCosmeticVeil]" foregroundlayer="true" visible="{islocked}" />
	</append>

	<!-- ================================================================ -->
	<!-- Party and companion health bars (HUD, top left)                  -->
	<!-- Same three layers as the stat bars: hatch pill under a dark     -->
	<!-- track filled to the injury-reduced max, under the health fill.   -->
	<!-- ================================================================ -->
	<set xpath="/templates/*[self::party_entry or self::companion_entry]/rect/sprite[@name='border']/@color">[transparent]</set>
	<set xpath="/templates/*[self::party_entry or self::companion_entry]/rect/filledsprite[@name='BarHealthModifiedMax']/@color">[transparent]</set>

	<setattribute xpath="/templates/party_entry/rect/sprite[@name='background']" name="sprite">ku_partyhatch</setattribute>
	<setattribute xpath="/templates/party_entry/rect/sprite[@name='BarHealthModifiedMax' or @name='BarHealth']" name="sprite">ku_partybar</setattribute>
	<setattribute xpath="/templates/companion_entry/rect/sprite[@name='background']" name="sprite">ku_companionhatch</setattribute>
	<setattribute xpath="/templates/companion_entry/rect/sprite[@name='BarHealthModifiedMax' or @name='BarHealth']" name="sprite">ku_companionbar</setattribute>

	<set xpath="/templates/*[self::party_entry or self::companion_entry]/rect/sprite[@name='background']/@type">simple</set>
	<set xpath="/templates/*[self::party_entry or self::companion_entry]/rect/sprite[@name='background']/@color">[kuHatch]</set>
	<set xpath="/templates/*[self::party_entry or self::companion_entry]/rect/sprite[@name='BarHealthModifiedMax']/@color">[kuHudTrack]</set>
	<!-- Party health colour comes from the controller's attribute; the companion's is inline. -->
	<set xpath="/templates/party_entry/rect/@default_health_color">255,107,90,235</set>
	<set xpath="/templates/companion_entry/rect/sprite[@name='BarHealth']/@color">255,107,90,235</set>
	<setattribute xpath="/templates/*[self::party_entry or self::companion_entry]/rect/label[@name='TextContent'][@text='{name}']" name="effect">outline</setattribute>

	<!-- ================================================================ -->
	<!-- Dialog response rows (trader / NPC options)                      -->
	<!-- The row text takes {rowstatecolor}: hover_color on hover, white  -->
	<!-- when selected, enabled_color otherwise. A teal highlight behind  -->
	<!-- the row keys off that same value, so it shows on hover/select.   -->
	<!-- ================================================================ -->
	<set xpath="/templates/response_entry/rect/@width">630</set>
	<set xpath="/templates/response_entry/rect/label[@name='Text']/@width">575</set>
	<setattribute xpath="/templates/response_entry/rect/label[@name='Text']" name="overflow">shrinkcontent</setattribute>
	<prepend xpath="/templates/response_entry/rect">
		<sprite depth="1" name="kuRowBg" sprite="ku_round_sm" type="sliced" pos="2,-3" width="624" height="37"
			color="{% rowstatecolor = '217,184,115,255' or rowstatecolor = '255,255,255,255' ? color(30,84,118,235) : color(0,0,0,0) }" />
	</prepend>

	<!-- ================================================================ -->
	<!-- Crafting queue cell (recipe_stack)                               -->
	<!-- Vanilla: black 3px frame over a solid [mediumGrey] square, which -->
	<!-- the palette turns into an opaque indigo block. Give it the same  -->
	<!-- dark well and edge as an item slot.                              -->
	<!-- ================================================================ -->
	<set xpath="/templates/recipe_stack/rect/sprite[@name='backgroundMain']/@sprite">ku_slot_ring</set>
	<set xpath="/templates/recipe_stack/rect/sprite[@name='backgroundMain']/@color">[kuEdge]</set>
	<set xpath="/templates/recipe_stack/rect/sprite[@name='backgroundMain']/@pos">0,0</set>
	<set xpath="/templates/recipe_stack/rect/sprite[@name='backgroundMain']/@width">72</set>
	<set xpath="/templates/recipe_stack/rect/sprite[@name='backgroundMain']/@height">72</set>
	<setattribute xpath="/templates/recipe_stack/rect/sprite[@name='background']" name="sprite">ku_slot_fill</setattribute>
	<set xpath="/templates/recipe_stack/rect/sprite[@name='background']/@color">[kuSlotWell]</set>
	<!-- ================================================================ -->
	<!-- Recipe rows and item-action buttons                              -->
	<!-- Game code drives the background: 64 grey + "menu_empty" idle, 96 -->
	<!-- grey on hover, white + "ui_game_select_row" when selected (action -->
	<!-- buttons: on hover). It swaps sprite NAMES but never the atlas, so -->
	<!-- these sprites point at our KitsuneRows atlas, where both names    -->
	<!-- are baked to land as navy / lighter navy / steel-cyan.            -->
	<!-- ================================================================ -->
	<set xpath="/templates/recipe_entry/rect/sprite[@name='backgroundMain']/@color">[transparent]</set>
	<setattribute xpath="/templates/recipe_entry/rect/sprite[@name='background']" name="atlas">KitsuneRows</setattribute>
	<setattribute xpath="/templates/recipe_entry/rect/sprite[@name='background']" name="sprite">menu_empty</setattribute>
	<set xpath="/templates/recipe_entry/rect/sprite[@name='background']/@color">[kuRowGrey]</set>

	<setattribute xpath="/templates/*[self::item_action_entry or self::skill_action_entry]/rect/sprite[@name='background']" name="atlas">KitsuneRows</setattribute>
	<setattribute xpath="/templates/*[self::item_action_entry or self::skill_action_entry]/rect/sprite[@name='background']" name="sprite">menu_empty</setattribute>
	<set xpath="/templates/*[self::item_action_entry or self::skill_action_entry]/rect/sprite[@name='background']/@color">[kuRowGrey]</set>
	<set xpath="/templates/*[self::item_action_entry or self::skill_action_entry]/rect/@default_background_color">[kuRowGrey]</set>

	<!-- ================================================================ -->
	<!-- Ingredient / unlocked-by tables (recipe and item info panels)    -->
	<!-- Vanilla: opaque grey cells boxed in black 3px frames. Ours:      -->
	<!-- soft rounded cells, gold header row, no frames.                  -->
	<!-- ================================================================ -->
	<set xpath="/templates/*[self::ingredient_header or self::ingredient_row or self::unlocked_by_header or self::unlocked_by_row]//sprite[@name='backgroundMain']/@color">[transparent]</set>
	<setattribute xpath="/templates/*[self::ingredient_header or self::ingredient_row or self::unlocked_by_header or self::unlocked_by_row]//sprite[not(@sprite)][not(@name)]" name="sprite">ku_round_sm</setattribute>
	<set xpath="/templates/*[self::ingredient_header or self::unlocked_by_header]//sprite[not(@name)]/@color">[kuCellHeader]</set>
	<set xpath="/templates/*[self::ingredient_row or self::unlocked_by_row]//sprite[not(@name)]/@color">[kuCell]</set>
	<setattribute xpath="/templates/*[self::ingredient_header or self::unlocked_by_header]//label" name="color">[kuGold]</setattribute>

	<!-- The dimming overlay over a queued item: rounded, in the glass's own dark. -->
	<setattribute xpath="/templates/recipe_stack/rect/sprite[@name='overlay']" name="sprite">ku_slot_fill</setattribute>
	<set xpath="/templates/recipe_stack/rect/sprite[@name='overlay']/@color">6,8,20,128</set>

</configs>
